          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NONCOMPLIANT", "VERDICT: INCOMPLETE_COVERAGE"]
        }
      ]
    },
    {
      "id": "sg-common-full-coverage-ok",
      "name": "READY SECURITY_GROUPS_COMMON policy org-wide with full coverage and zero violations — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/sg-common-full-coverage-ok.md",
      "baseline_file": "baselines/sg-common-full-coverage-ok.md",
      "expected_verdict": "OK",
      "expected_risk": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "sg-common-full-coverage-ok", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NONCOMPLIANT", "VERDICT: CONFIG_GAP", "VERDICT: INCOMPLETE_COVERAGE"]
        }
      ]
    },
    {
      "id": "waf-legacy-policy-type",
      "name": "READY FMS policy using PolicyType WAF (WAF Classic) — legacy migration gap",
      "difficulty": "hard",
      "prompt_file": "prompts/waf-legacy-policy-type.md",
