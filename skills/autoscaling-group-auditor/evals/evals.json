{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "autoscaling-group-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Auto Scaling Group Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "elb-healthcheck-no-targetgroup",
      "name": "ELB health check with no target group — infinite replacement loop",
      "difficulty": "hard",
      "prompt_file": "prompts/elb-healthcheck-no-targetgroup.md",
      "baseline_file": "baselines/elb-healthcheck-no-targetgroup.md",
      "expected_verdict": "MISCONFIGURED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MISCONFIGURED", "prod-web-asg", "VERDICT", "REASON", "REMEDIATION", "ELB"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "legacy-launch-config-desired-over-max",
      "name": "Legacy launch configuration with DesiredCapacity exceeding MaxSize",
      "difficulty": "medium",
      "prompt_file": "prompts/legacy-launch-config-desired-over-max.md",
      "baseline_file": "baselines/legacy-launch-config-desired-over-max.md",
      "expected_verdict": "MISCONFIGURED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MISCONFIGURED", "legacy-batch-asg", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "spot-single-instance-type",
      "name": "Single Spot instance type in MIP — total outage on interruption",
      "difficulty": "hard",
      "prompt_file": "prompts/spot-single-instance-type.md",
      "baseline_file": "baselines/spot-single-instance-type.md",
      "expected_verdict": "MISCONFIGURED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MISCONFIGURED", "prod-spot-worker-asg", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "imdsv2-gap-short-grace",
      "name": "IMDSv2 not required and 30s ELB grace period — security and operational gaps",
      "difficulty": "medium",
      "prompt_file": "prompts/imdsv2-gap-short-grace.md",
      "baseline_file": "baselines/imdsv2-gap-short-grace.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "staging-api-asg", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: MISCONFIGURED"]
        }
      ]
    },
    {
      "id": "ec2-check-elb-attached",
      "name": "EC2 health check behind ELB with single AZ and no scale-out headroom",
      "difficulty": "medium",
      "prompt_file": "prompts/ec2-check-elb-attached.md",
      "baseline_file": "baselines/ec2-check-elb-attached.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "prod-backend-asg", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: MISCONFIGURED"]
        }
      ]
    },
    {
      "id": "well-configured-production-asg",
      "name": "Well-configured production ASG — clean posture across all dimensions",
      "difficulty": "easy",
      "prompt_file": "prompts/well-configured-production-asg.md",
      "baseline_file": "baselines/well-configured-production-asg.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "prod-frontend-asg", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: MISCONFIGURED", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
