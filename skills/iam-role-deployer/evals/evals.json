{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "iam-role-deployer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the IAM Role Deployer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "lambda-service-role-scoped",
      "name": "Lambda service role with SourceArn/SourceAccount conditions — all dimensions pass",
      "difficulty": "easy",
      "prompt_file": "prompts/lambda-service-role-scoped.md",
      "baseline_file": "baselines/lambda-service-role-scoped.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "lambda-service-role-scoped", "VERDICT", "CHECKLIST", "DEPLOY_COMMANDS", "lambda.amazonaws.com", "SourceArn"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
      "id": "cross-account-externalid-deploy-role",
