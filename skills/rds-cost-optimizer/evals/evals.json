{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "rds-cost-optimizer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the RDS Cost Optimizer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "overprovisioned-postgres-rightsize-ri",
      "name": "db.r6i.2xlarge PostgreSQL at 12% CPU / 28 GB FreeableMemory, On-Demand — clear downsize + Graviton + RI opportunity",
      "difficulty": "medium",
      "prompt_file": "prompts/overprovisioned-postgres-rightsize-ri.md",
      "baseline_file": "baselines/overprovisioned-postgres-rightsize-ri.md",
      "expected_verdict": "OPPORTUNITY_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPPORTUNITY_FOUND", "overprovisioned-postgres-rightsize-ri", "RECOMMENDATION", "ESTIMATED_SAVINGS", "MIGRATION_STEPS", "Graviton"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: ALREADY_OPTIMAL", "VERDICT: NEED_MORE_INFO", "Savings Plan"]
        }
      ]
    },
    {
      "id": "idle-database-deletion",
      "name": "MySQL database with 0 connections for 30+ days — strong idle-database deletion candidate",
      "difficulty": "hard",
      "prompt_file": "prompts/idle-database-deletion.md",
      "baseline_file": "baselines/idle-database-deletion.md",
      "expected_verdict": "OPPORTUNITY_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPPORTUNITY_FOUND", "idle-database-deletion", "RECOMMENDATION", "application team"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: ALREADY_OPTIMAL", "VERDICT: NEED_MORE_INFO", "downsize"]
        }
      ]
    },
    {
      "id": "multiaz-nonprod-removal",
      "name": "Staging PostgreSQL with Multi-AZ enabled — disable Multi-AZ to halve compute cost",
      "difficulty": "medium",
      "prompt_file": "prompts/multiaz-nonprod-removal.md",
      "baseline_file": "baselines/multiaz-nonprod-removal.md",
      "expected_verdict": "OPPORTUNITY_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPPORTUNITY_FOUND", "multiaz-nonprod-removal", "RECOMMENDATION", "Multi-AZ"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: ALREADY_OPTIMAL", "VERDICT: NEED_MORE_INFO"]
        }
      ]
    },
    {
      "id": "already-optimal-prod-postgres-ri",
      "name": "db.r6g.2xlarge PostgreSQL on 3-yr RI, healthy utilization — already optimal",
      "difficulty": "easy",
      "prompt_file": "prompts/already-optimal-prod-postgres-ri.md",
      "baseline_file": "baselines/already-optimal-prod-postgres-ri.md",
      "expected_verdict": "ALREADY_OPTIMAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ALREADY_OPTIMAL", "already-optimal-prod-postgres-ri", "REASON"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OPPORTUNITY_FOUND", "VERDICT: NEED_MORE_INFO"]
        }
      ]
    },
    {
      "id": "aurora-serverless-acu-tuning",
      "name": "Aurora Serverless v2 with min ACU 8 but actual avg ACU 4 — lower min ACU to save $526/month",
      "difficulty": "hard",
      "prompt_file": "prompts/aurora-serverless-acu-tuning.md",
      "baseline_file": "baselines/aurora-serverless-acu-tuning.md",
      "expected_verdict": "OPPORTUNITY_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPPORTUNITY_FOUND", "aurora-serverless-acu-tuning", "min ACU", "RECOMMENDATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: ALREADY_OPTIMAL", "VERDICT: NEED_MORE_INFO"]
        }
      ]
    }
  ]
}
