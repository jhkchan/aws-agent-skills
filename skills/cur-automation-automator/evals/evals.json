{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "cur-automation-automator",
  "version": "1.0.0",
  "description": "Structured eval definitions for the CUR Automation Automator. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "greenfield-cur-athena-automated",
      "name": "Greenfield CUR + Athena setup on payer — all requirements satisfied (AUTOMATED)",
      "difficulty": "easy",
      "prompt_file": "prompts/greenfield-cur-athena-automated.md",
      "baseline_file": "baselines/greenfield-cur-athena-automated.md",
      "expected_verdict": "AUTOMATED",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATED", "prod-cur-automation", "AWS::CUR::ReportDefinition", "VERDICT", "projection.enabled"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: MANUAL_STEP_REQUIRED"]
        }
      ]
    },
    {
      "id": "linked-account-caller-manual",
      "name": "Linked (member) account caller cannot create organization-wide CUR (MANUAL_STEP_REQUIRED)",
      "difficulty": "hard",
