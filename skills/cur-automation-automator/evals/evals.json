      "expected_verdict": "MANUAL_STEP_REQUIRED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MANUAL_STEP_REQUIRED", "payer", "111111111111", "VERDICT", "222222222222"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: AUTOMATED"]
        }
      ]
    },
    {
