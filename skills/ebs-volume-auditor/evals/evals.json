{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "ebs-volume-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the EBS Volume Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "public-snapshot-block-exposure",
      "name": "Public EBS snapshot with Group:all — block-data exposure to every AWS account",
      "difficulty": "hard",
      "prompt_file": "prompts/public-snapshot-block-exposure.md",
      "baseline_file": "baselines/public-snapshot-block-exposure.md",
      "expected_verdict": "PUBLIC_SNAPSHOT",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC_SNAPSHOT", "public-exposure", "VERDICT", "REASON", "REMEDIATION", "CRITICAL", "reset-snapshot-attribute"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNENCRYPTED"]
        }
      ]
    },
    {
      "id": "unencrypted-volume-compliance-violation",
      "name": "Unencrypted EBS volume in-use — compliance violation (PCI/HIPAA/SOC2)",
      "difficulty": "medium",
      "prompt_file": "prompts/unencrypted-volume-compliance-violation.md",
      "baseline_file": "baselines/unencrypted-volume-compliance-violation.md",
      "expected_verdict": "UNENCRYPTED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNENCRYPTED", "unencrypted-volume", "VERDICT", "REASON", "REMEDIATION", "HIGH", "copy-snapshot"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_SNAPSHOT"]
        }
      ]
    },
    {
      "id": "unattached-volume-cost-waste",
      "name": "Detached gp3 volume > 90 days — pure GB-month cost waste",
      "difficulty": "medium",
      "prompt_file": "prompts/unattached-volume-cost-waste.md",
      "baseline_file": "baselines/unattached-volume-cost-waste.md",
      "expected_verdict": "UNATTACHED",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNATTACHED", "unattached-volume", "VERDICT", "REASON", "REMEDIATION", "MEDIUM", "delete-volume"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: LEGACY_TYPE"]
        }
      ]
    },
    {
      "id": "stale-snapshot-no-consumer",
      "name": "Snapshot > 90 days with no AMI/FSR/restore reference — stale storage cost",
      "difficulty": "hard",
      "prompt_file": "prompts/stale-snapshot-no-consumer.md",
      "baseline_file": "baselines/stale-snapshot-no-consumer.md",
      "expected_verdict": "STALE_SNAPSHOT",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["STALE_SNAPSHOT", "stale-snapshot", "VERDICT", "REASON", "REMEDIATION", "MEDIUM", "delete-snapshot"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNENCRYPTED"]
        }
      ]
    },
    {
      "id": "legacy-type-gp2-volume",
      "name": "Encrypted attached gp2 volume — legacy type with online gp3 upgrade",
      "difficulty": "easy",
      "prompt_file": "prompts/legacy-type-gp2-volume.md",
      "baseline_file": "baselines/legacy-type-gp2-volume.md",
      "expected_verdict": "LEGACY_TYPE",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["LEGACY_TYPE", "legacy-gp2-volume", "VERDICT", "REASON", "REMEDIATION", "LOW", "modify-volume"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNENCRYPTED"]
        }
      ]
    },
    {
      "id": "encrypted-gp3-attached-ok",
      "name": "Encrypted gp3 attached volume — all dimensions clean",
      "difficulty": "easy",
      "prompt_file": "prompts/encrypted-gp3-attached-ok.md",
      "baseline_file": "baselines/encrypted-gp3-attached-ok.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "encrypted-gp3-ok", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: CRITICAL", "VERDICT: UNENCRYPTED", "VERDICT: LEGACY_TYPE"]
        }
      ]
    }
  ]
}
