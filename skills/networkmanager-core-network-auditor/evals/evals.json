{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "networkmanager-core-network-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Network Manager Core Network Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "detached-vpc-attachment",
      "name": "VPC attachment in DETACHED status — active traffic disruption",
      "difficulty": "medium",
      "prompt_file": "prompts/detached-vpc-attachment.md",
      "baseline_file": "baselines/detached-vpc-attachment.md",
      "expected_verdict": "DETACHED_ATTACHMENT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["DETACHED_ATTACHMENT", "detached-vpc-attachment", "VERDICT", "REASON", "REMEDIATION", "DETACHED"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CIDR_OVERLAP"]
        }
      ]
    },
    {
      "id": "permissive-resource-policy",
      "name": "Wildcard Principal * with networkmanager:* on resource policy — route injection vector",
      "difficulty": "easy",
      "prompt_file": "prompts/permissive-resource-policy.md",
      "baseline_file": "baselines/permissive-resource-policy.md",
      "expected_verdict": "PERMISSIVE_POLICY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PERMISSIVE_POLICY", "permissive-resource-policy", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DETACHED_ATTACHMENT"]
        }
      ]
    },
    {
      "id": "overlapping-cidr-two-attachments",
      "name": "Overlapping CIDRs across two VPC attachments in different segments — silent misrouting",
      "difficulty": "medium",
      "prompt_file": "prompts/overlapping-cidr-two-attachments.md",
      "baseline_file": "baselines/overlapping-cidr-two-attachments.md",
      "expected_verdict": "CIDR_OVERLAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CIDR_OVERLAP", "overlapping-cidr-two-attachments", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DETACHED_ATTACHMENT"]
        }
      ]
    },
    {
      "id": "policy-generation-mismatch",
      "name": "LATEST policy generation != LIVE — changes staged but not deployed",
      "difficulty": "hard",
      "prompt_file": "prompts/policy-generation-mismatch.md",
      "baseline_file": "baselines/policy-generation-mismatch.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "policy-generation-mismatch", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DETACHED_ATTACHMENT"]
        }
      ]
    },
    {
      "id": "well-segmented-core-network",
      "name": "Well-configured core network with proper isolation — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/well-segmented-core-network.md",
      "baseline_file": "baselines/well-segmented-core-network.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "well-segmented-core-network", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: DETACHED_ATTACHMENT", "VERDICT: CIDR_OVERLAP"]
        }
      ]
    },
    {
      "id": "detached-and-overlap-compound",
      "name": "Compound case — DETACHED attachment AND CIDR overlap; worst verdict wins",
      "difficulty": "hard",
      "prompt_file": "prompts/detached-and-overlap-compound.md",
      "baseline_file": "baselines/detached-and-overlap-compound.md",
      "expected_verdict": "DETACHED_ATTACHMENT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["DETACHED_ATTACHMENT", "detached-and-overlap-compound", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
