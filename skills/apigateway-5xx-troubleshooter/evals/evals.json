{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "apigateway-5xx-troubleshooter",
  "version": "1.0.0",
  "description": "Structured eval definitions for the API Gateway 5xx Troubleshooter. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "502-lambda-proxy-malformed-response",
      "name": "REST API Lambda proxy returns bare object without statusCode — 502 BadGateway",
      "difficulty": "medium",
      "prompt_file": "prompts/502-lambda-proxy-malformed-response.md",
      "baseline_file": "baselines/502-lambda-proxy-malformed-response.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "expected_layer": "BACKEND_RESPONSE_FORMAT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "502-lambda-proxy-malformed-response", "BACKEND_RESPONSE_FORMAT", "VERDICT", "REASON", "EVIDENCE", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "VERDICT: ESCALATE", "LAYER: BACKEND_LAMBDA_ERROR"]
        }
      ]
    },
    {
      "id": "504-timeout-mismatch-lambda-too-high",
      "name": "Lambda Timeout 60s exceeds REST API integration 29s ceiling — 504 GatewayTimeout",
      "difficulty": "hard",
      "prompt_file": "prompts/504-timeout-mismatch-lambda-too-high.md",
      "baseline_file": "baselines/504-timeout-mismatch-lambda-too-high.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "expected_layer": "TIMEOUT_MISMATCH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "timeout-mismatch-lambda-too-high", "TIMEOUT_MISMATCH", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "LAYER: BACKEND_LAMBDA_ERROR"]
        }
      ]
    },
    {
      "id": "503-stage-throttle-exceeded",
      "name": "Stage rate/burst exceeded during traffic spike, Lambda never invoked — 503 ServiceUnavailable",
      "difficulty": "medium",
      "prompt_file": "prompts/503-stage-throttle-exceeded.md",
      "baseline_file": "baselines/503-stage-throttle-exceeded.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "expected_layer": "THROTTLE_STAGE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "stage-throttle-exceeded", "THROTTLE_STAGE", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "LAYER: THROTTLE_CONCURRENCY", "LAYER: THROTTLE_USAGE_PLAN"]
        }
      ]
    },
    {
      "id": "502-vpclink-unhealthy-target",
      "name": "VPC Link integration to NLB with all targets unhealthy — 502 BadGateway",
      "difficulty": "hard",
      "prompt_file": "prompts/502-vpclink-unhealthy-target.md",
      "baseline_file": "baselines/502-vpclink-unhealthy-target.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "expected_layer": "BACKEND_VPC_LINK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "vpclink-unhealthy-target", "BACKEND_VPC_LINK", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "LAYER: BACKEND_LAMBDA_ERROR", "LAYER: BACKEND_RESPONSE_FORMAT"]
        }
      ]
    },
    {
      "id": "502-lambda-runtime-error",
      "name": "Lambda function crashes with Runtime.LogError (missing env var) — 502 BadGateway",
      "difficulty": "medium",
      "prompt_file": "prompts/502-lambda-runtime-error.md",
      "baseline_file": "baselines/502-lambda-runtime-error.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "expected_layer": "BACKEND_LAMBDA_ERROR",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "lambda-runtime-error", "BACKEND_LAMBDA_ERROR", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "LAYER: BACKEND_RESPONSE_FORMAT"]
        }
      ]
    }
  ]
}
