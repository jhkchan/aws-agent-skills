{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "redshift-cluster-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Redshift Cluster Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "public-cluster-no-encryption",
      "name": "Internet-exposed Redshift cluster with every dimension failing — PUBLIC wins (Step 1)",
      "difficulty": "easy",
      "prompt_file": "prompts/public-cluster-no-encryption.md",
      "baseline_file": "baselines/public-cluster-no-encryption.md",
      "expected_verdict": "PUBLIC",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC", "public-cluster-no-encryption", "VERDICT", "REASON", "REMEDIATION", "PubliclyAccessible"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ENCRYPTION", "VERDICT: NO_SSL", "VERDICT: NO_AUDIT_LOG", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "private-unencrypted",
      "name": "Private cluster with encryption disabled — immutable migration path; NO_ENCRYPTION wins (Step 2)",
      "difficulty": "medium",
      "prompt_file": "prompts/private-unencrypted.md",
      "baseline_file": "baselines/private-unencrypted.md",
      "expected_verdict": "NO_ENCRYPTION",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ENCRYPTION", "private-unencrypted", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "no-ssl-default-param-group",
      "name": "Private encrypted cluster on default parameter group with require_ssl engine-default false — NO_SSL wins (Step 3)",
      "difficulty": "medium",
      "prompt_file": "prompts/no-ssl-default-param-group.md",
      "baseline_file": "baselines/no-ssl-default-param-group.md",
      "expected_verdict": "NO_SSL",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_SSL", "no-ssl-default-param-group", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC", "VERDICT: NO_ENCRYPTION", "VERDICT: NO_AUDIT_LOG"]
        }
      ]
    },
    {
      "id": "audit-logging-disabled-clean",
      "name": "Otherwise clean cluster with S3 audit logging disabled — NO_AUDIT_LOG wins (Step 4)",
      "difficulty": "medium",
      "prompt_file": "prompts/audit-logging-disabled-clean.md",
      "baseline_file": "baselines/audit-logging-disabled-clean.md",
      "expected_verdict": "NO_AUDIT_LOG",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_AUDIT_LOG", "audit-logging-disabled-clean", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC", "VERDICT: NO_SSL", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "config-gap-no-snapshots-no-evr",
      "name": "Otherwise clean cluster with snapshot retention 0 and EnhancedVPCRouting off — CONFIG_GAP via Step 5 aggregation",
      "difficulty": "hard",
      "prompt_file": "prompts/config-gap-no-snapshots-no-evr.md",
      "baseline_file": "baselines/config-gap-no-snapshots-no-evr.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "config-gap-no-snapshots-no-evr", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC", "VERDICT: NO_SSL", "VERDICT: NO_AUDIT_LOG"]
        }
      ]
    },
    {
      "id": "fully-hardened-ok",
      "name": "Clean posture across all six dimensions — OK verdict",
      "difficulty": "easy",
      "prompt_file": "prompts/fully-hardened-ok.md",
      "baseline_file": "baselines/fully-hardened-ok.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "fully-hardened-ok", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PUBLIC", "VERDICT: NO_ENCRYPTION", "VERDICT: NO_SSL", "VERDICT: NO_AUDIT_LOG", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
