{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "rds-instance-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the RDS Instance Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "public-and-unencrypted",
      "name": "PubliclyAccessible true + StorageEncrypted false — internet-exposed plaintext database",
      "difficulty": "medium",
      "prompt_file": "prompts/public-and-unencrypted.md",
      "baseline_file": "baselines/public-and-unencrypted.md",
      "expected_verdict": "PUBLIC",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC", "public-and-unencrypted", "VERDICT", "REASON", "REMEDIATION", "PubliclyAccessible"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "unencrypted-internal-db",
      "name": "Private instance with StorageEncrypted false, other dimensions clean — plaintext at rest",
      "difficulty": "medium",
      "prompt_file": "prompts/unencrypted-internal-db.md",
      "baseline_file": "baselines/unencrypted-internal-db.md",
      "expected_verdict": "UNENCRYPTED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNENCRYPTED", "unencrypted-internal-db", "VERDICT", "REASON", "REMEDIATION", "StorageEncrypted"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "no-deletion-protection-prod",
      "name": "Private encrypted Multi-AZ production instance with DeletionProtection false",
      "difficulty": "easy",
      "prompt_file": "prompts/no-deletion-protection-prod.md",
      "baseline_file": "baselines/no-deletion-protection-prod.md",
      "expected_verdict": "NO_DELETION_PROTECTION",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_DELETION_PROTECTION", "no-deletion-protection-prod", "VERDICT", "REASON", "REMEDIATION", "DeletionProtection"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC", "VERDICT: SINGLE_AZ"]
        }
      ]
    },
    {
      "id": "single-az-dev",
      "name": "Private encrypted primary with MultiAZ false — single-AZ availability gap",
      "difficulty": "easy",
      "prompt_file": "prompts/single-az-dev.md",
      "baseline_file": "baselines/single-az-dev.md",
      "expected_verdict": "SINGLE_AZ",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["SINGLE_AZ", "single-az-dev", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: PUBLIC"]
        }
      ]
    },
    {
      "id": "config-gap-stale",
      "name": "Backups disabled, minor-version upgrade off, Enhanced Monitoring off — CONFIG_GAP",
      "difficulty": "hard",
      "prompt_file": "prompts/config-gap-stale.md",
      "baseline_file": "baselines/config-gap-stale.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "config-gap-stale", "VERDICT", "REASON", "REMEDIATION", "BackupRetentionPeriod"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC", "VERDICT: SINGLE_AZ"]
        }
      ]
    },
    {
      "id": "hardened-multi-az-prod",
      "name": "All seven dimensions pass — clean hardened production instance",
      "difficulty": "easy",
      "prompt_file": "prompts/hardened-multi-az-prod.md",
      "baseline_file": "baselines/hardened-multi-az-prod.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "hardened-multi-az-prod", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PUBLIC", "VERDICT: UNENCRYPTED", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
