{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "bedrock-guardrail-coverage-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Bedrock Guardrail Coverage Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "no-guardrail-models-unprotected",
      "name": "No guardrail exists — every model invocation is unguarded",
      "difficulty": "easy",
      "prompt_file": "prompts/no-guardrail-models-unprotected.md",
      "baseline_file": "baselines/no-guardrail-models-unprotected.md",
      "expected_verdict": "NO_GUARDRAIL",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_GUARDRAIL", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: WEAK_FILTER"]
        }
      ]
    },
    {
      "id": "draft-guardrail-not-ready",
      "name": "Guardrail in DRAFT status — strong filters but zero enforcement",
      "difficulty": "medium",
      "prompt_file": "prompts/draft-guardrail-not-ready.md",
      "baseline_file": "baselines/draft-guardrail-not-ready.md",
      "expected_verdict": "NO_GUARDRAIL",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_GUARDRAIL", "DRAFT", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: WEAK_FILTER"]
        }
      ]
    },
    {
      "id": "partial-model-coverage",
      "name": "Guardrail READY with strong filters but 3 of 5 resources omit guardrail ID",
      "difficulty": "hard",
      "prompt_file": "prompts/partial-model-coverage.md",
      "baseline_file": "baselines/partial-model-coverage.md",
      "expected_verdict": "INCOMPLETE_COVERAGE",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["INCOMPLETE_COVERAGE", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_GUARDRAIL"]
        }
      ]
    },
    {
      "id": "content-filters-all-none",
      "name": "All four content categories at NONE — content policy effectively disabled",
      "difficulty": "medium",
      "prompt_file": "prompts/content-filters-all-none.md",
      "baseline_file": "baselines/content-filters-all-none.md",
      "expected_verdict": "WEAK_FILTER",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["WEAK_FILTER", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_GUARDRAIL"]
        }
      ]
    },
    {
      "id": "grounding-threshold-zero",
      "name": "Contextual grounding threshold at 0.0 — filter configured but functionally disabled",
      "difficulty": "hard",
      "prompt_file": "prompts/grounding-threshold-zero.md",
      "baseline_file": "baselines/grounding-threshold-zero.md",
      "expected_verdict": "WEAK_FILTER",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["WEAK_FILTER", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_GUARDRAIL"]
        }
      ]
    },
    {
      "id": "strong-guardrail-full-coverage",
      "name": "Guardrail READY, full coverage, strong filters, proper grounding — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/strong-guardrail-full-coverage.md",
      "baseline_file": "baselines/strong-guardrail-full-coverage.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_GUARDRAIL", "VERDICT: WEAK_FILTER"]
        }
      ]
    }
  ]
}
