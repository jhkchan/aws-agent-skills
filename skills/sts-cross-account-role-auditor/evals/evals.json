{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "sts-cross-account-role-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the STS Cross-Account Role Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "wildcard-principal-open",
      "name": "Wildcard Principal with no condition — open to any AWS credential holder",
      "difficulty": "easy",
      "prompt_file": "prompts/wildcard-principal-open.md",
      "baseline_file": "baselines/wildcard-principal-open.md",
      "expected_verdict": "WILDCARD_TRUST",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["WILDCARD_TRUST", "wildcard-principal-open", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONDITIONAL"]
        }
      ]
    },
    {
      "id": "cross-account-root-no-externalid",
      "name": "Cross-account root ARN without ExternalId — unguarded cross-account trust",
      "difficulty": "medium",
      "prompt_file": "prompts/cross-account-root-no-externalid.md",
      "baseline_file": "baselines/cross-account-root-no-externalid.md",
      "expected_verdict": "EXTERNAL_TRUST",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["EXTERNAL_TRUST", "cross-account-root-no-externalid", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: WILDCARD_TRUST"]
        }
      ]
    },
    {
      "id": "cross-account-with-externalid",
      "name": "Cross-account root ARN with sts:ExternalId — guarded cross-account trust",
      "difficulty": "medium",
      "prompt_file": "prompts/cross-account-with-externalid.md",
      "baseline_file": "baselines/cross-account-with-externalid.md",
      "expected_verdict": "CONDITIONAL",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONDITIONAL", "cross-account-with-externalid", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: WILDCARD_TRUST", "VERDICT: EXTERNAL_TRUST"]
        }
      ]
    },
    {
      "id": "confused-deputy-no-source",
      "name": "Service principal (lambda) without source guard — confused-deputy vulnerable",
      "difficulty": "hard",
      "prompt_file": "prompts/confused-deputy-no-source.md",
      "baseline_file": "baselines/confused-deputy-no-source.md",
      "expected_verdict": "EXTERNAL_TRUST",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["EXTERNAL_TRUST", "confused-deputy-no-source", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: WILDCARD_TRUST"]
        }
      ]
    },
    {
      "id": "confused-deputy-with-source-arn",
      "name": "Service principal with aws:SourceArn and SourceAccount — confused-deputy guarded",
      "difficulty": "hard",
      "prompt_file": "prompts/confused-deputy-with-source-arn.md",
      "baseline_file": "baselines/confused-deputy-with-source-arn.md",
      "expected_verdict": "CONDITIONAL",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONDITIONAL", "confused-deputy-with-source-arn", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: WILDCARD_TRUST", "VERDICT: EXTERNAL_TRUST"]
        }
      ]
    },
    {
      "id": "same-account-scoped-ok",
      "name": "Same-account role ARN principal — properly scoped internal trust",
      "difficulty": "easy",
      "prompt_file": "prompts/same-account-scoped-ok.md",
      "baseline_file": "baselines/same-account-scoped-ok.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "same-account-scoped-ok", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: WILDCARD_TRUST", "VERDICT: EXTERNAL_TRUST"]
        }
      ]
    }
  ]
}
