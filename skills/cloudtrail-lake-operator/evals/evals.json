      "difficulty": "medium",
      "prompt_file": "prompts/run-partiql-aggregation-ready.md",
      "baseline_file": "baselines/run-partiql-aggregation-ready.md",
      "expected_verdict": "READY",
      "expected_risk": "MODERATE",
      "files": [],
