      "difficulty": "medium",
      "prompt_file": "prompts/create-eds-mgmt-events-sse-kms-ready.md",
      "baseline_file": "baselines/create-eds-mgmt-events-sse-kms-ready.md",
      "expected_verdict": "READY",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY", "create-event-data-store", "Management", "kms:GenerateDataKey", "VERDICT", "PRE_CHECKS", "CONFIRM"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: BLOCKED", "VERDICT: COMPLETED"]
        }
      ]
    },
    {
      "id": "diagnose-empty-query-event-category-mismatch-blocked",
