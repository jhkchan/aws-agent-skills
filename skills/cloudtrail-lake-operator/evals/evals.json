          "type": "must_contain",
          "values": ["BLOCKED", "EventCategory", "Data", "update-event-data-store", "VERDICT", "PRE_CHECKS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: READY", "VERDICT: COMPLETED"]
        }
      ]
    },
    {
      "id": "run-partiql-aggregation-ready",
