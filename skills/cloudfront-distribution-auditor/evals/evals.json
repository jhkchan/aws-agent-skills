{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "cloudfront-distribution-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the CloudFront Distribution Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "tls-v1-allow-all",
      "name": "TLSv1 minimum protocol with allow-all viewer protocol — HTTP served to viewers",
      "difficulty": "easy",
      "prompt_file": "prompts/tls-v1-allow-all.md",
      "baseline_file": "baselines/tls-v1-allow-all.md",
      "expected_verdict": "INSECURE_TLS",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["INSECURE_TLS", "tls-v1-allow-all", "VERDICT", "REASON", "REMEDIATION", "allow-all"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "s3-origin-no-access-control",
      "name": "S3 REST origin with no OAC and no OAI — direct bucket bypass",
      "difficulty": "medium",
      "prompt_file": "prompts/s3-origin-no-access-control.md",
      "baseline_file": "baselines/s3-origin-no-access-control.md",
      "expected_verdict": "NO_OAC",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_OAC", "s3-origin-no-access-control", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "missing-waf-and-logging",
      "name": "Strong TLS and OAC but missing WAF and disabled logging — defense-in-depth gaps",
      "difficulty": "medium",
      "prompt_file": "prompts/missing-waf-and-logging.md",
      "baseline_file": "baselines/missing-waf-and-logging.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "missing-waf-and-logging", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: INSECURE_TLS"]
        }
      ]
    },
    {
      "id": "fully-secured-distribution",
      "name": "All dimensions pass — TLSv1.2_2021, https-only, OAC, WAF, logging, geo",
      "difficulty": "easy",
      "prompt_file": "prompts/fully-secured-distribution.md",
      "baseline_file": "baselines/fully-secured-distribution.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "fully-secured-distribution", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSECURE_TLS", "VERDICT: NO_OAC", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "insecure-origin-protocol",
      "name": "Custom origin with http-only OriginProtocolPolicy — unencrypted origin traffic",
      "difficulty": "hard",
      "prompt_file": "prompts/insecure-origin-protocol.md",
      "baseline_file": "baselines/insecure-origin-protocol.md",
      "expected_verdict": "INSECURE_TLS",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["INSECURE_TLS", "insecure-origin-protocol", "VERDICT", "REASON", "REMEDIATION", "http-only"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "legacy-oai-and-geo-gap",
      "name": "S3 origin with legacy OAI (no OAC) and no geographic restrictions — deprecated access plus geo gap",
      "difficulty": "hard",
      "prompt_file": "prompts/legacy-oai-and-geo-gap.md",
      "baseline_file": "baselines/legacy-oai-and-geo-gap.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "legacy-oai-and-geo-gap", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: INSECURE_TLS"]
        }
      ]
    }
  ]
}
