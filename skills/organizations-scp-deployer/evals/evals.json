{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "organizations-scp-deployer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Organizations SCP Deployer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "guardrail-deny-regions-ready",
      "name": "Guardrail SCP denying unapproved regions at root (READY_TO_DEPLOY)",
      "difficulty": "medium",
      "prompt_file": "prompts/guardrail-deny-regions-ready.md",
      "baseline_file": "baselines/guardrail-deny-regions-ready.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "deny-unapproved-regions", "create-policy", "attach-policy", "VERDICT", "CONFIRM", "guardrail"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
      "id": "policy-type-not-enabled-blocked",
      "name": "SCP deployment when policy type is not enabled on root (PREREQUISITES_MISSING)",
      "difficulty": "easy",
      "prompt_file": "prompts/policy-type-not-enabled-blocked.md",
      "baseline_file": "baselines/policy-type-not-enabled-blocked.md",
      "expected_verdict": "PREREQUISITES_MISSING",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PREREQUISITES_MISSING", "SERVICE_CONTROL_POLICY", "enable-policy-type", "VERDICT"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: READY_TO_DEPLOY", "create-policy"]
        }
      ]
    },
    {
      "id": "delegate-allowlist-ready-with-warning",
      "name": "Delegate allowlist SCP at root with lockout warning (READY_TO_DEPLOY)",
      "difficulty": "hard",
      "prompt_file": "prompts/delegate-allowlist-ready-with-warning.md",
      "baseline_file": "baselines/delegate-allowlist-ready-with-warning.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "delegate", "FullAWSAccess", "detach", "VERDICT", "CONFIRM", "WARN"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
      "id": "root-deny-cannot-be-overridden-blocked",
      "name": "Root Deny with OU-level Allow override request (PREREQUISITES_MISSING — intersection rule)",
      "difficulty": "hard",
      "prompt_file": "prompts/root-deny-cannot-be-overridden-blocked.md",
      "baseline_file": "baselines/root-deny-cannot-be-overridden-blocked.md",
      "expected_verdict": "PREREQUISITES_MISSING",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PREREQUISITES_MISSING", "intersection", "VERDICT", "OU"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: READY_TO_DEPLOY"]
        }
      ]
    },
    {
      "id": "called-via-chained-service-ready",
      "name": "Guardrail SCP using aws:CalledVia for chained CloudFormation-IAM calls (READY_TO_DEPLOY)",
      "difficulty": "medium",
      "prompt_file": "prompts/called-via-chained-service-ready.md",
      "baseline_file": "baselines/called-via-chained-service-ready.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "aws:CalledVia", "cloudformation.amazonaws.com", "VERDICT", "CONFIRM"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    }
  ]
}
