{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "cloudfront-cost-optimizer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the CloudFront Cost Optimizer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "priceclass-all-us-only-viewers",
      "name": "PriceClass_All with 98% US/EU viewers — switch to PriceClass_100",
      "difficulty": "medium",
      "prompt_file": "prompts/priceclass-all-us-only-viewers.md",
      "baseline_file": "baselines/priceclass-all-us-only-viewers.md",
      "expected_verdict": "OPPORTUNITY_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPPORTUNITY_FOUND", "priceclass-all-us-only-viewers", "PriceClass_100", "RECOMMENDATION", "ESTIMATED_SAVINGS", "MIGRATION_STEPS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: ALREADY_OPTIMAL", "VERDICT: NEED_MORE_INFO"]
        }
      ]
    },
    {
      "id": "low-cache-hit-ratio-utm-fragmentation",
      "name": "CacheHitRate 58% on static content — UTMs fragmenting the cache key",
      "difficulty": "hard",
      "prompt_file": "prompts/low-cache-hit-ratio-utm-fragmentation.md",
      "baseline_file": "baselines/low-cache-hit-ratio-utm-fragmentation.md",
      "expected_verdict": "OPPORTUNITY_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPPORTUNITY_FOUND", "low-cache-hit-ratio-utm-fragmentation", "RECOMMENDATION", "cache policy", "ESTIMATED_SAVINGS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: ALREADY_OPTIMAL", "VERDICT: NEED_MORE_INFO"]
        }
      ]
    },
    {
      "id": "compression-off-static-assets",
      "name": "Compression disabled on text-heavy static site — enable Brotli/gzip for 50-90% byte savings",
      "difficulty": "easy",
      "prompt_file": "prompts/compression-off-static-assets.md",
      "baseline_file": "baselines/compression-off-static-assets.md",
      "expected_verdict": "OPPORTUNITY_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPPORTUNITY_FOUND", "compression-off-static-assets", "RECOMMENDATION", "ompress", "ESTIMATED_SAVINGS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: ALREADY_OPTIMAL", "VERDICT: NEED_MORE_INFO"]
        }
      ]
    },
    {
      "id": "shield-advanced-marketing-site",
      "name": "Shield Advanced on a non-DDoS-prone marketing site — drop the $3,000/month charge",
      "difficulty": "medium",
      "prompt_file": "prompts/shield-advanced-marketing-site.md",
      "baseline_file": "baselines/shield-advanced-marketing-site.md",
      "expected_verdict": "OPPORTUNITY_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPPORTUNITY_FOUND", "shield-advanced-marketing-site", "Shield", "RECOMMENDATION", "3,000"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: ALREADY_OPTIMAL", "VERDICT: NEED_MORE_INFO"]
        }
      ]
    },
    {
      "id": "already-optimal-distribution",
      "name": "All nine cost dimensions at optimal config — Security Savings Bundle adopted",
      "difficulty": "easy",
      "prompt_file": "prompts/already-optimal-distribution.md",
      "baseline_file": "baselines/already-optimal-distribution.md",
      "expected_verdict": "ALREADY_OPTIMAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ALREADY_OPTIMAL", "already-optimal-distribution", "REASON"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OPPORTUNITY_FOUND", "VERDICT: NEED_MORE_INFO"]
        }
      ]
    }
  ]
}
