{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "eventbridge-pipe-deployer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the EventBridge Pipe Deployer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "ddb-streams-lambda-filter-dlq",
      "name": "Standard DynamoDB Streams pipe to Lambda with filter pattern and pipe-level DLQ",
      "difficulty": "easy",
      "prompt_file": "prompts/ddb-streams-lambda-filter-dlq.md",
      "baseline_file": "baselines/ddb-streams-lambda-filter-dlq.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "prod-orders-pipe", "VERDICT", "CHECKLIST", "DEPLOY_COMMANDS", "DynamoDB Streams"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
      "id": "kinesis-stepfunctions-batch-window",
