{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "eks-cluster-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the EKS Cluster Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "public-endpoint-open",
      "name": "Public API endpoint with unrestricted 0.0.0.0/0 CIDR — internet-reachable control plane",
      "difficulty": "easy",
      "prompt_file": "prompts/public-endpoint-open.md",
      "baseline_file": "baselines/public-endpoint-open.md",
      "expected_verdict": "PUBLIC_ENDPOINT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC_ENDPOINT", "public-endpoint-open", "VERDICT", "REASON", "REMEDIATION", "0.0.0.0/0"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: LOGGING_DISABLED", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "logging-all-disabled",
      "name": "Private endpoint but all control-plane log types disabled — no forensic record",
      "difficulty": "medium",
      "prompt_file": "prompts/logging-all-disabled.md",
      "baseline_file": "baselines/logging-all-disabled.md",
      "expected_verdict": "LOGGING_DISABLED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["LOGGING_DISABLED", "logging-all-disabled", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_ENDPOINT", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "system-masters-node-role",
      "name": "Node IAM role mapped to system:masters with wildcard username — pod-to-cluster-admin escalation",
      "difficulty": "hard",
      "prompt_file": "prompts/system-masters-node-role.md",
      "baseline_file": "baselines/system-masters-node-role.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "system-masters-node-role", "VERDICT", "REASON", "REMEDIATION", "system:masters"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_ENDPOINT", "VERDICT: LOGGING_DISABLED"]
        }
      ]
    },
    {
      "id": "open-security-group",
      "name": "Node security group allows 0.0.0.0/0 on kubelet port 10250 — direct kubelet API access from internet",
      "difficulty": "medium",
      "prompt_file": "prompts/open-security-group.md",
      "baseline_file": "baselines/open-security-group.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "open-security-group", "VERDICT", "REASON", "REMEDIATION", "10250"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_ENDPOINT", "VERDICT: LOGGING_DISABLED"]
        }
      ]
    },
    {
      "id": "outdated-version",
      "name": "Cluster running Kubernetes 1.28 with latest available 1.32 (N-4) — past end-of-standard-support",
      "difficulty": "medium",
      "prompt_file": "prompts/outdated-version.md",
      "baseline_file": "baselines/outdated-version.md",
      "expected_verdict": "OUTDATED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OUTDATED", "outdated-version", "VERDICT", "REASON", "REMEDIATION", "1.28"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_ENDPOINT", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "clean-hardened-cluster",
      "name": "Fully hardened EKS cluster — private endpoint, logging on, scoped IAM, restricted SGs, current version",
      "difficulty": "easy",
      "prompt_file": "prompts/clean-hardened-cluster.md",
      "baseline_file": "baselines/clean-hardened-cluster.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "clean-hardened-cluster", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PUBLIC_ENDPOINT", "VERDICT: LOGGING_DISABLED", "VERDICT: CONFIG_GAP", "VERDICT: OUTDATED"]
        }
      ]
    }
  ]
}
