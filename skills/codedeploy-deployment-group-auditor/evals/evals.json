{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "codedeploy-deployment-group-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the CodeDeploy Deployment Group Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "no-rollback-no-alarms",
      "name": "No auto-rollback and no alarm monitoring — worst case deployment posture",
      "difficulty": "easy",
      "prompt_file": "prompts/no-rollback-no-alarms.md",
      "baseline_file": "baselines/no-rollback-no-alarms.md",
      "expected_verdict": "NO_ROLLBACK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ROLLBACK", "no-rollback-no-alarms-dg", "VERDICT", "REASON", "REMEDIATION", "rollback"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ALARMS", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "rollback-disabled-alarms-on",
      "name": "Alarms enabled but auto-rollback disabled — alarms fire but deployment does not recover",
      "difficulty": "medium",
      "prompt_file": "prompts/rollback-disabled-alarms-on.md",
      "baseline_file": "baselines/rollback-disabled-alarms-on.md",
      "expected_verdict": "NO_ROLLBACK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ROLLBACK", "rollback-disabled-dg", "VERDICT", "REASON", "REMEDIATION", "rollback"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ALARMS", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "rollback-on-no-alarms",
      "name": "Auto-rollback enabled but alarm monitoring disabled — deployment-level safety without app-level visibility",
      "difficulty": "medium",
      "prompt_file": "prompts/rollback-on-no-alarms.md",
      "baseline_file": "baselines/rollback-on-no-alarms.md",
      "expected_verdict": "NO_ALARMS",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ALARMS", "rollback-on-no-alarms-dg", "VERDICT", "REASON", "REMEDIATION", "alarm"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ROLLBACK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "allatatime-config-gap",
      "name": "AllAtATime deployment config with rollback and alarms enabled — all instances at risk simultaneously",
      "difficulty": "medium",
      "prompt_file": "prompts/allatatime-config-gap.md",
      "baseline_file": "baselines/allatatime-config-gap.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "allatatime-config-gap-dg", "VERDICT", "REASON", "REMEDIATION", "AllAtATime"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ROLLBACK", "VERDICT: NO_ALARMS"]
        }
      ]
    },
    {
      "id": "bluegreen-immediate-termination",
      "name": "Blue/green with 0-minute termination wait — no baking window for delayed failures",
      "difficulty": "hard",
      "prompt_file": "prompts/bluegreen-immediate-termination.md",
      "baseline_file": "baselines/bluegreen-immediate-termination.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "bluegreen-immediate-term-dg", "VERDICT", "REASON", "REMEDIATION", "termination"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ROLLBACK", "VERDICT: NO_ALARMS"]
        }
      ]
    },
    {
      "id": "properly-configured-ok",
      "name": "All safety dimensions properly configured — rollback, alarms, OneAtATime, in-place",
      "difficulty": "easy",
      "prompt_file": "prompts/properly-configured-ok.md",
      "baseline_file": "baselines/properly-configured-ok.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "properly-configured-ok-dg", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_ROLLBACK", "VERDICT: NO_ALARMS", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
