{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "iam-key-rotation-automator",
  "version": "1.0.0",
  "description": "Structured eval definitions for the IAM Key Rotation Automator. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "standard-90-day-rotation",
      "name": "Standard 90-day key rotation — AUTOMATION_DEPLOYED with full overlap flow",
      "difficulty": "easy",
      "prompt_file": "prompts/standard-90-day-rotation.md",
      "baseline_file": "baselines/standard-90-day-rotation.md",
      "expected_verdict": "AUTOMATION_DEPLOYED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATION_DEPLOYED", "standard-90-day-rotation", "OVERLAP", "VERDICT", "ROTATION_FLOW", "DETECTION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: REVIEW_REQUIRED"]
        }
      ]
    },
    {
      "id": "break-glass-exception",
      "name": "Break-glass account on exception list — REVIEW_REQUIRED, auto-rotation refused",
      "difficulty": "medium",
      "prompt_file": "prompts/break-glass-exception.md",
      "baseline_file": "baselines/break-glass-exception.md",
      "expected_verdict": "REVIEW_REQUIRED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["REVIEW_REQUIRED", "break-glass-exception", "VERDICT", "GAP", "exception"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: AUTOMATION_DEPLOYED"]
        }
      ]
    },
    {
      "id": "overlap-window-rotation",
      "name": "95-day key with overlap window design — AUTOMATION_DEPLOYED",
      "difficulty": "medium",
      "prompt_file": "prompts/overlap-window-rotation.md",
      "baseline_file": "baselines/overlap-window-rotation.md",
      "expected_verdict": "AUTOMATION_DEPLOYED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATION_DEPLOYED", "overlap-window-rotation", "OVERLAP", "VERDICT", "deactivate"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: REVIEW_REQUIRED"]
        }
      ]
    },
    {
      "id": "cross-account-key-sync",
      "name": "Cross-account key sync — AUTOMATION_DEPLOYED with STS assume-role sync",
      "difficulty": "hard",
      "prompt_file": "prompts/cross-account-key-sync.md",
      "baseline_file": "baselines/cross-account-key-sync.md",
      "expected_verdict": "AUTOMATION_DEPLOYED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATION_DEPLOYED", "cross-account-key-sync", "VERDICT", "cross-account", "OVERLAP"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: REVIEW_REQUIRED"]
        }
      ]
    },
    {
      "id": "sts-migration-required",
      "name": "EC2 app with permanent key — REVIEW_REQUIRED, STS migration recommended",
      "difficulty": "hard",
      "prompt_file": "prompts/sts-migration-required.md",
      "baseline_file": "baselines/sts-migration-required.md",
      "expected_verdict": "REVIEW_REQUIRED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["REVIEW_REQUIRED", "sts-migration-required", "VERDICT", "GAP", "STS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: AUTOMATION_DEPLOYED"]
        }
      ]
    }
  ]
}
