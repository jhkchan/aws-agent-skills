{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "lakeformation-data-lake-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Lake Formation Data Lake Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "catalog-all-to-role",
      "name": "Permissions ALL with WithGrantablePermissions ALL on Catalog to non-admin role — admin escalation via grant",
      "difficulty": "medium",
      "prompt_file": "prompts/catalog-all-to-role.md",
      "baseline_file": "baselines/catalog-all-to-role.md",
      "expected_verdict": "OVERPERMISSIVE_GRANT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OVERPERMISSIVE_GRANT", "VERDICT", "REASON", "FINDINGS", "REMEDIATION", "ALL"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: EXTERNAL_ACCOUNT"]
        }
      ]
    },
    {
      "id": "cross-account-database-share",
      "name": "Lake Formation grant to a principal whose 12-digit account ID differs from the catalog owner — cross-account data sharing",
      "difficulty": "medium",
      "prompt_file": "prompts/cross-account-database-share.md",
      "baseline_file": "baselines/cross-account-database-share.md",
      "expected_verdict": "EXTERNAL_ACCOUNT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["EXTERNAL_ACCOUNT", "VERDICT", "REASON", "FINDINGS", "REMEDIATION", "cross-account"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: OVERPERMISSIVE_GRANT"]
        }
      ]
    },
    {
      "id": "column-wildcard-select-no-filter",
      "name": "SELECT with ColumnWildcard on a PII-tagged TableWithColumns with no DataCellsFilter — full-column read, no row scoping",
      "difficulty": "hard",
      "prompt_file": "prompts/column-wildcard-select-no-filter.md",
      "baseline_file": "baselines/column-wildcard-select-no-filter.md",
      "expected_verdict": "OVERPERMISSIVE_GRANT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OVERPERMISSIVE_GRANT", "VERDICT", "REASON", "FINDINGS", "REMEDIATION", "wildcard"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: EXTERNAL_ACCOUNT"]
        }
      ]
    },
    {
      "id": "grant-on-unregistered-path",
      "name": "Column-scoped SELECT on a named table whose S3 path is NOT under any Lake Formation registered location — ineffective grant",
      "difficulty": "hard",
      "prompt_file": "prompts/grant-on-unregistered-path.md",
      "baseline_file": "baselines/grant-on-unregistered-path.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "FINDINGS", "REMEDIATION", "unregistered"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: OVERPERMISSIVE_GRANT", "VERDICT: EXTERNAL_ACCOUNT"]
        }
      ]
    },
    {
      "id": "clean-column-scoped-with-filter",
      "name": "Named permissions on named TableWithColumns with explicit ColumnNames, same-account role, wired DataCellsFilter — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/clean-column-scoped-with-filter.md",
      "baseline_file": "baselines/clean-column-scoped-with-filter.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OVERPERMISSIVE_GRANT", "VERDICT: EXTERNAL_ACCOUNT", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "empty-admins-and-iam-mixed-mode",
      "name": "Empty DataLakeAdmins list plus IAMAllowedPrincipals database with explicit LF grants on its tables — no break-glass admin and mixed-mode leakage",
      "difficulty": "hard",
      "prompt_file": "prompts/empty-admins-and-iam-mixed-mode.md",
      "baseline_file": "baselines/empty-admins-and-iam-mixed-mode.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "FINDINGS", "REMEDIATION", "admin"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: OVERPERMISSIVE_GRANT", "VERDICT: EXTERNAL_ACCOUNT"]
        }
      ]
    }
  ]
}
