{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "config-recorder-coverage-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Config Recorder Coverage Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "config-gap-no-recorder",
      "name": "No configuration recorder — no recording at all",
      "difficulty": "easy",
      "prompt_file": "prompts/config-gap-no-recorder.md",
      "baseline_file": "baselines/config-gap-no-recorder.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "config-gap-no-recorder", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DELIVERY_GAP"]
        }
      ]
    },
    {
      "id": "delivery-gap-bucket-deleted",
      "name": "Delivery channel FAILURE — S3 bucket deleted (NO_SUCH_BUCKET)",
      "difficulty": "medium",
      "prompt_file": "prompts/delivery-gap-bucket-deleted.md",
      "baseline_file": "baselines/delivery-gap-bucket-deleted.md",
      "expected_verdict": "DELIVERY_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["DELIVERY_GAP", "delivery-gap-bucket-deleted", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "incomplete-coverage-partial-types",
      "name": "allSupported false — only 3 resource types recorded",
      "difficulty": "medium",
      "prompt_file": "prompts/incomplete-coverage-partial-types.md",
      "baseline_file": "baselines/incomplete-coverage-partial-types.md",
      "expected_verdict": "INCOMPLETE_COVERAGE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["INCOMPLETE_COVERAGE", "incomplete-coverage-partial-types", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DELIVERY_GAP", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "no-rules-clean-recorder",
      "name": "Recorder and delivery healthy but zero Config rules",
      "difficulty": "easy",
      "prompt_file": "prompts/no-rules-clean-recorder.md",
      "baseline_file": "baselines/no-rules-clean-recorder.md",
      "expected_verdict": "NO_RULES",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_RULES", "no-rules-clean-recorder", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: INCOMPLETE_COVERAGE"]
        }
      ]
    },
    {
      "id": "full-coverage-ok",
      "name": "All layers healthy — recorder, delivery, rules, conformance packs",
      "difficulty": "easy",
      "prompt_file": "prompts/full-coverage-ok.md",
      "baseline_file": "baselines/full-coverage-ok.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["full-coverage-ok", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: CONFIG_GAP", "VERDICT: DELIVERY_GAP", "VERDICT: INCOMPLETE_COVERAGE", "VERDICT: NO_RULES"]
        }
      ]
    },
    {
      "id": "multi-region-global-types-gap",
      "name": "No region has includeGlobalResourceTypes — global resources never recorded",
      "difficulty": "hard",
      "prompt_file": "prompts/multi-region-global-types-gap.md",
      "baseline_file": "baselines/multi-region-global-types-gap.md",
      "expected_verdict": "INCOMPLETE_COVERAGE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["INCOMPLETE_COVERAGE", "multi-region-global-types-gap", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DELIVERY_GAP"]
        }
      ]
    }
  ]
}
