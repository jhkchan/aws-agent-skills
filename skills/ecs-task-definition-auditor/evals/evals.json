{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "ecs-task-definition-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the ECS Task Definition Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "privileged-ec2-sidecar",
      "name": "Privileged container on EC2 — full host kernel access",
      "difficulty": "easy",
      "prompt_file": "prompts/privileged-ec2-sidecar.md",
      "baseline_file": "baselines/privileged-ec2-sidecar.md",
      "expected_verdict": "PRIVILEGED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PRIVILEGED", "privileged-ec2-sidecar", "VERDICT", "REASON", "REMEDIATION", "privileged"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: SECRET_LEAK", "VERDICT: INSECURE"]
        }
      ]
    },
    {
      "id": "password-in-env-var",
      "name": "DATABASE_PASSWORD in plaintext environment — credential leak in task definition JSON",
      "difficulty": "medium",
      "prompt_file": "prompts/password-in-env-var.md",
      "baseline_file": "baselines/password-in-env-var.md",
      "expected_verdict": "SECRET_LEAK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["SECRET_LEAK", "password-in-env-var", "VERDICT", "REASON", "REMEDIATION", "DATABASE_PASSWORD"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PRIVILEGED", "VERDICT: INSECURE"]
        }
      ]
    },
    {
      "id": "host-network-root-user",
      "name": "Host network mode and root user — no network isolation, runs as UID 0",
      "difficulty": "medium",
      "prompt_file": "prompts/host-network-root-user.md",
      "baseline_file": "baselines/host-network-root-user.md",
      "expected_verdict": "INSECURE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["INSECURE", "host-network-root-user", "VERDICT", "REASON", "REMEDIATION", "host", "root"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PRIVILEGED", "VERDICT: SECRET_LEAK"]
        }
      ]
    },
    {
      "id": "missing-resource-limits",
      "name": "No CPU/memory limits and no logging — production-readiness gaps",
      "difficulty": "easy",
      "prompt_file": "prompts/missing-resource-limits.md",
      "baseline_file": "baselines/missing-resource-limits.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "missing-resource-limits", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PRIVILEGED", "VERDICT: SECRET_LEAK", "VERDICT: INSECURE"]
        }
      ]
    },
    {
      "id": "hardened-fargate-task",
      "name": "Hardened Fargate task — all dimensions pass (non-root, secrets via Secrets Manager, resource limits, readonly root fs)",
      "difficulty": "easy",
      "prompt_file": "prompts/hardened-fargate-task.md",
      "baseline_file": "baselines/hardened-fargate-task.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "hardened-fargate-task", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PRIVILEGED", "VERDICT: SECRET_LEAK", "VERDICT: INSECURE", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "aggregate-worst-finding",
      "name": "Multiple findings across all dimensions — worst verdict wins (PRIVILEGED)",
      "difficulty": "hard",
      "prompt_file": "prompts/aggregate-worst-finding.md",
      "baseline_file": "baselines/aggregate-worst-finding.md",
      "expected_verdict": "PRIVILEGED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PRIVILEGED", "aggregate-worst-finding", "VERDICT", "REASON", "REMEDIATION", "privileged", "API_KEY"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: INSECURE", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
