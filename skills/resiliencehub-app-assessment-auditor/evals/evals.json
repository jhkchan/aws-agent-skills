{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "resiliencehub-app-assessment-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Resilience Hub App Assessment Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "stale-95-days",
      "name": "Successful assessment 95 days old — staleness invalidates downstream compliance data",
      "difficulty": "hard",
      "prompt_file": "prompts/stale-95-days.md",
      "baseline_file": "baselines/stale-95-days.md",
      "expected_verdict": "STALE_ASSESSMENT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["STALE_ASSESSMENT", "VERDICT", "REASON", "REMEDIATION", "freshness"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: HIGH_RISK", "VERDICT: LOW_COMPLIANCE"]
        }
      ]
    },
    {
      "id": "mission-critical-breach",
      "name": "Fresh assessment with a MissionCritical-tier NonCompliant component — HIGH_RISK via Step 5a",
      "difficulty": "hard",
      "prompt_file": "prompts/mission-critical-breach.md",
      "baseline_file": "baselines/mission-critical-breach.md",
      "expected_verdict": "HIGH_RISK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["HIGH_RISK", "VERDICT", "REASON", "REMEDIATION", "MissionCritical"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: LOW_COMPLIANCE", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "low-score-standard-tier",
      "name": "Fresh assessment, complianceScore 70, NonCompliant components only in Standard tier — LOW_COMPLIANCE",
      "difficulty": "medium",
      "prompt_file": "prompts/low-score-standard-tier.md",
      "baseline_file": "baselines/low-score-standard-tier.md",
      "expected_verdict": "LOW_COMPLIANCE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["LOW_COMPLIANCE", "VERDICT", "REASON", "REMEDIATION", "compliance"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: HIGH_RISK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "missing-policy-no-alarms",
      "name": "Fresh assessment, decent score, but no policy attached and unimplemented alarm recommendations — CONFIG_GAP",
      "difficulty": "medium",
      "prompt_file": "prompts/missing-policy-no-alarms.md",
      "baseline_file": "baselines/missing-policy-no-alarms.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "REMEDIATION", "policy"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: HIGH_RISK", "VERDICT: LOW_COMPLIANCE"]
        }
      ]
    },
    {
      "id": "failed-assessment-no-data",
      "name": "Latest assessment Failed with no compliance data — CONFIG_GAP (not zero compliance)",
      "difficulty": "medium",
      "prompt_file": "prompts/failed-assessment-no-data.md",
      "baseline_file": "baselines/failed-assessment-no-data.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "REMEDIATION", "Failed"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: HIGH_RISK", "VERDICT: LOW_COMPLIANCE"]
        }
      ]
    },
    {
      "id": "healthy-app",
      "name": "Fresh assessment, score 95, all compliant, policy attached, all alarms implemented — OK",
      "difficulty": "easy",
      "prompt_file": "prompts/healthy-app.md",
      "baseline_file": "baselines/healthy-app.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT: OK", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: STALE_ASSESSMENT", "VERDICT: HIGH_RISK", "VERDICT: LOW_COMPLIANCE", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
