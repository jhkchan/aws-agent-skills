{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "msk-cluster-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the MSK Cluster Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "plaintext-broker",
      "name": "ClientBroker PLAINTEXT — all traffic unencrypted",
      "difficulty": "easy",
      "prompt_file": "prompts/plaintext-broker.md",
      "baseline_file": "baselines/plaintext-broker.md",
      "expected_verdict": "NO_ENCRYPTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ENCRYPTION", "plaintext-broker", "VERDICT", "REASON", "REMEDIATION", "PLAINTEXT"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNAUTHENTICATED", "VERDICT: PUBLIC_ACCESS"]
        }
      ]
    },
    {
      "id": "unauthenticated-clients",
      "name": "TLS encrypted but unauthenticated client access enabled — open data plane",
      "difficulty": "medium",
      "prompt_file": "prompts/unauthenticated-clients.md",
      "baseline_file": "baselines/unauthenticated-clients.md",
      "expected_verdict": "UNAUTHENTICATED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNAUTHENTICATED", "unauthenticated-clients", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ENCRYPTION", "VERDICT: PUBLIC_ACCESS"]
        }
      ]
    },
    {
      "id": "public-access-brokers",
      "name": "TLS + IAM auth but brokers exposed via Elastic IPs — internet-reachable",
      "difficulty": "medium",
      "prompt_file": "prompts/public-access-brokers.md",
      "baseline_file": "baselines/public-access-brokers.md",
      "expected_verdict": "PUBLIC_ACCESS",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC_ACCESS", "public-access-brokers", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ENCRYPTION", "VERDICT: UNAUTHENTICATED"]
        }
      ]
    },
    {
      "id": "no-broker-logging",
      "name": "TLS + IAM auth + private but all broker logging disabled — no forensic record",
      "difficulty": "medium",
      "prompt_file": "prompts/no-broker-logging.md",
      "baseline_file": "baselines/no-broker-logging.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "no-broker-logging", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "tls-plaintext-mixed",
      "name": "ClientBroker TLS_PLAINTEXT dual-mode — plaintext path breaks encryption guarantee",
      "difficulty": "hard",
      "prompt_file": "prompts/tls-plaintext-mixed.md",
      "baseline_file": "baselines/tls-plaintext-mixed.md",
      "expected_verdict": "NO_ENCRYPTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ENCRYPTION", "tls-plaintext-mixed", "VERDICT", "REASON", "REMEDIATION", "TLS_PLAINTEXT"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "fully-hardened-cluster",
      "name": "Full TLS + mTLS + IAM + logging + CMK — clean hardened posture",
      "difficulty": "easy",
      "prompt_file": "prompts/fully-hardened-cluster.md",
      "baseline_file": "baselines/fully-hardened-cluster.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "fully-hardened-cluster", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_ENCRYPTION", "VERDICT: UNAUTHENTICATED", "VERDICT: PUBLIC_ACCESS", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
