{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "wafv2-web-acl-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the WAFv2 Web ACL Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "misconfigured-zero-rule-allow",
      "name": "Zero-rule ACL with DefaultAction Allow — open door",
      "difficulty": "easy",
      "prompt_file": "prompts/misconfigured-zero-rule-allow.md",
      "baseline_file": "baselines/misconfigured-zero-rule-allow.md",
      "expected_verdict": "MISCONFIGURED",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MISCONFIGURED", "open-door-acl", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: ADEQUATE"]
        }
      ]
    },
    {
      "id": "misconfigured-count-mode",
      "name": "All managed rule groups in COUNT mode — protection disabled",
      "difficulty": "medium",
      "prompt_file": "prompts/misconfigured-count-mode.md",
      "baseline_file": "baselines/misconfigured-count-mode.md",
      "expected_verdict": "MISCONFIGURED",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MISCONFIGURED", "count-mode-acl", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: OK", "VERDICT: ADEQUATE"]
        }
      ]
    },
    {
      "id": "weak-minimal-no-logging",
      "name": "CommonRuleSet in BLOCK but no rate rule and no logging — significant gaps",
      "difficulty": "medium",
      "prompt_file": "prompts/weak-minimal-no-logging.md",
      "baseline_file": "baselines/weak-minimal-no-logging.md",
      "expected_verdict": "WEAK",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["WEAK", "minimal-acl", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: OK", "VERDICT: MISCONFIGURED"]
        }
      ]
    },
    {
      "id": "adequate-good-baseline",
      "name": "CommonRuleSet + KnownBadInputs in BLOCK with rate rule and logging — adequate with minor gap",
      "difficulty": "hard",
      "prompt_file": "prompts/adequate-good-baseline.md",
      "baseline_file": "baselines/adequate-good-baseline.md",
      "expected_verdict": "ADEQUATE",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ADEQUATE", "baseline-protected-acl", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: MISCONFIGURED", "VERDICT: WEAK"]
        }
      ]
    },
    {
      "id": "weak-shadow-bypass-rule",
      "name": "Shadow Allow rule at priority 0 matching /api/ bypasses all managed rules",
      "difficulty": "hard",
      "prompt_file": "prompts/weak-shadow-bypass-rule.md",
      "baseline_file": "baselines/weak-shadow-bypass-rule.md",
      "expected_verdict": "MISCONFIGURED",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MISCONFIGURED", "shadow-bypass-acl", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: OK", "VERDICT: ADEQUATE"]
        }
      ]
    },
    {
      "id": "ok-comprehensive",
      "name": "Comprehensive managed rules in BLOCK with forwarded-IP rate rule and logging — clean posture",
      "difficulty": "medium",
      "prompt_file": "prompts/ok-comprehensive.md",
      "baseline_file": "baselines/ok-comprehensive.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "production-hardened-acl", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: MISCONFIGURED", "VERDICT: WEAK"]
        }
      ]
    }
  ]
}
