{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "network-firewall-rule-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Network Firewall Rule Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "permissive-wildcard-stateful-pass",
      "name": "Suricata wildcard pass rule — all traffic allowed, drop rules shadowed",
      "difficulty": "medium",
      "prompt_file": "prompts/permissive-wildcard-stateful-pass.md",
      "baseline_file": "baselines/permissive-wildcard-stateful-pass.md",
      "expected_verdict": "PERMISSIVE_RULE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PERMISSIVE_RULE", "VERDICT", "REASON", "REMEDIATION", "wildcard"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: ROUTING_GAP", "VERDICT: NO_TLS_INSPECTION"]
        }
      ]
    },
    {
      "id": "routing-gap-app-subnet-bypass",
      "name": "App subnet route table bypasses firewall ENI — traffic egresses uninspected",
      "difficulty": "hard",
      "prompt_file": "prompts/routing-gap-app-subnet-bypass.md",
      "baseline_file": "baselines/routing-gap-app-subnet-bypass.md",
      "expected_verdict": "ROUTING_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROUTING_GAP", "VERDICT", "REASON", "REMEDIATION", "route"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PERMISSIVE_RULE"]
        }
      ]
    },
    {
      "id": "no-tls-inspection-missing-config",
      "name": "No TLS inspection config with payload-matching rules — blind to HTTPS threats",
      "difficulty": "medium",
      "prompt_file": "prompts/no-tls-inspection-missing-config.md",
      "baseline_file": "baselines/no-tls-inspection-missing-config.md",
      "expected_verdict": "NO_TLS_INSPECTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_TLS_INSPECTION", "VERDICT", "REASON", "REMEDIATION", "TLS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "config-gap-no-logging",
      "name": "Clean policy but no logging configuration — firewall decisions invisible",
      "difficulty": "easy",
      "prompt_file": "prompts/config-gap-no-logging.md",
      "baseline_file": "baselines/config-gap-no-logging.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "REMEDIATION", "log"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PERMISSIVE_RULE"]
        }
      ]
    },
    {
      "id": "permissive-fragment-default-pass",
      "name": "Stateless fragment default set to pass — fragments bypass all inspection",
      "difficulty": "hard",
      "prompt_file": "prompts/permissive-fragment-default-pass.md",
      "baseline_file": "baselines/permissive-fragment-default-pass.md",
      "expected_verdict": "PERMISSIVE_RULE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PERMISSIVE_RULE", "VERDICT", "REASON", "REMEDIATION", "fragment"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "ok-clean-firewall",
      "name": "Well-configured firewall — scoped rules, correct defaults, TLS on, routing valid, logging on",
      "difficulty": "easy",
      "prompt_file": "prompts/ok-clean-firewall.md",
      "baseline_file": "baselines/ok-clean-firewall.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PERMISSIVE_RULE", "VERDICT: ROUTING_GAP"]
        }
      ]
    }
  ]
}
