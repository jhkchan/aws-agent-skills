          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "LAYER: ORIGIN_CONNECTION_TIMEOUT"]
        }
      ]
    },
    {
      "id": "failover-behaviour-points-at-primary-not-group",
      "name": "CloudFront 502 when primary origin fails; CacheBehavior TargetOriginId points at primary, not the OriginGroup",
      "difficulty": "hard",
      "prompt_file": "prompts/failover-behaviour-points-at-primary-not-group.md",
      "baseline_file": "baselines/failover-behaviour-points-at-primary-not-group.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
