        }
      ]
    },
    {
      "id": "cached-error-response-stale-502-after-recovery",
      "name": "CloudFront 502 persists for 5+ minutes after origin recovered; Custom Error Response ErrorCachingMinTTL: 300",
      "difficulty": "medium",
      "prompt_file": "prompts/cached-error-response-stale-502-after-recovery.md",
      "baseline_file": "baselines/cached-error-response-stale-502-after-recovery.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
