      "baseline_file": "baselines/lamp-app-static-ip-dns-ready.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "lamp-app-static-ip-dns-ready", "VERDICT", "CHECKLIST", "DEPLOY_COMMANDS", "medium_3_0", "static IP"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
