{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "lightsail-instance-deployer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Lightsail Instance Deployer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "lamp-app-static-ip-dns-ready",
      "name": "Standard LAMP blueprint deployment with static IP, DNS, snapshots, tightened firewall — all checklist dimensions pass",
