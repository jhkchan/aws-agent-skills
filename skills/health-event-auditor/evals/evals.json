{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "health-event-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the AWS Health Event Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "open-issue-ec2-degraded",
      "name": "Open issue with IMPAIRED entities — unresolved operational event",
      "difficulty": "easy",
      "prompt_file": "prompts/open-issue-ec2-degraded.md",
      "baseline_file": "baselines/open-issue-ec2-degraded.md",
      "expected_verdict": "UNRESOLVED_EVENT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNRESOLVED_EVENT", "VERDICT", "REASON", "REMEDIATION", "open", "IMPAIRED"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: SCHEDULED_CHANGE", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "scheduled-change-ec2-retirement",
      "name": "Upcoming scheduled change — deadline-driven action required",
      "difficulty": "medium",
      "prompt_file": "prompts/scheduled-change-ec2-retirement.md",
      "baseline_file": "baselines/scheduled-change-ec2-retirement.md",
      "expected_verdict": "SCHEDULED_CHANGE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["SCHEDULED_CHANGE", "VERDICT", "REASON", "REMEDIATION", "deadline", "stop and start"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNRESOLVED_EVENT", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "config-gap-no-org-view",
      "name": "Organization present but Health Organizational View disabled",
      "difficulty": "medium",
      "prompt_file": "prompts/config-gap-no-org-view.md",
      "baseline_file": "baselines/config-gap-no-org-view.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "REMEDIATION", "Organizational View", "disabled"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNRESOLVED_EVENT", "VERDICT: SCHEDULED_CHANGE"]
        }
      ]
    },
    {
      "id": "config-gap-no-eventbridge-rule",
      "name": "No EventBridge rule consuming aws.health events",
      "difficulty": "hard",
      "prompt_file": "prompts/config-gap-no-eventbridge-rule.md",
      "baseline_file": "baselines/config-gap-no-eventbridge-rule.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "REMEDIATION", "EventBridge"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNRESOLVED_EVENT", "VERDICT: SCHEDULED_CHANGE"]
        }
      ]
    },
    {
      "id": "ok-closed-event",
      "name": "Closed issue with all entities RESOLVED — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/ok-closed-event.md",
      "baseline_file": "baselines/ok-closed-event.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "VERDICT", "REASON", "REMEDIATION", "closed"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: UNRESOLVED_EVENT", "VERDICT: SCHEDULED_CHANGE", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "open-issue-partial-resolution",
      "name": "Open issue with mixed entity statuses — worst entity wins",
      "difficulty": "hard",
      "prompt_file": "prompts/open-issue-partial-resolution.md",
      "baseline_file": "baselines/open-issue-partial-resolution.md",
      "expected_verdict": "UNRESOLVED_EVENT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNRESOLVED_EVENT", "VERDICT", "REASON", "REMEDIATION", "IMPAIRED"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: SCHEDULED_CHANGE"]
        }
      ]
    }
  ]
}
