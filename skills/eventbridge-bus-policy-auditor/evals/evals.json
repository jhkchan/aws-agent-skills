{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "eventbridge-bus-policy-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the EventBridge Bus Policy Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "public-bus-wildcard-putevents",
      "name": "Wildcard events:PutEvents to Principal * — any account can inject events",
      "difficulty": "easy",
      "prompt_file": "prompts/public-bus-wildcard-putevents.md",
      "baseline_file": "baselines/public-bus-wildcard-putevents.md",
      "expected_verdict": "PUBLIC_BUS",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC_BUS", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_DLQ"]
        }
      ]
    },
    {
      "id": "no-dlq-silent-drop",
      "name": "Scoped bus policy but rule targets missing DeadLetterConfig — silent event loss",
      "difficulty": "medium",
      "prompt_file": "prompts/no-dlq-silent-drop.md",
      "baseline_file": "baselines/no-dlq-silent-drop.md",
      "expected_verdict": "NO_DLQ",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_DLQ", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_BUS"]
        }
      ]
    },
    {
      "id": "no-encryption-aws-managed",
      "name": "All else clean but KmsKeyIdentifier absent — AWS-owned key, no rotation control",
      "difficulty": "medium",
      "prompt_file": "prompts/no-encryption-aws-managed.md",
      "baseline_file": "baselines/no-encryption-aws-managed.md",
      "expected_verdict": "NO_ENCRYPTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ENCRYPTION", "VERDICT", "REASON", "REMEDIATION", "encryption"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_BUS"]
        }
      ]
    },
    {
      "id": "config-gap-no-archive",
      "name": "All else clean but no archive configured — no replay capability",
      "difficulty": "easy",
      "prompt_file": "prompts/config-gap-no-archive.md",
      "baseline_file": "baselines/config-gap-no-archive.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "REMEDIATION", "archive"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_BUS"]
        }
      ]
    },
    {
      "id": "ok-org-scoped-bus",
      "name": "Cross-account with aws:PrincipalOrgID + DLQ + CMK + archive — fully secured",
      "difficulty": "hard",
      "prompt_file": "prompts/ok-org-scoped-bus.md",
      "baseline_file": "baselines/ok-org-scoped-bus.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT: OK", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PUBLIC_BUS", "VERDICT: NO_DLQ"]
        }
      ]
    },
    {
      "id": "public-bus-weak-source-ip",
      "name": "Principal * + PutEvents + aws:SourceIp 0.0.0.0/0 — weak condition, still public",
      "difficulty": "hard",
      "prompt_file": "prompts/public-bus-weak-source-ip.md",
      "baseline_file": "baselines/public-bus-weak-source-ip.md",
      "expected_verdict": "PUBLIC_BUS",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC_BUS", "VERDICT", "REASON", "REMEDIATION", "0.0.0.0/0"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_DLQ"]
        }
      ]
    }
  ]
}
