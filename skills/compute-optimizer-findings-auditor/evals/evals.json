{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "compute-optimizer-findings-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Compute Optimizer Findings Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "ec2-overprovisioned-high-confidence",
      "name": "EC2 Overprovisioned with full metrics (CWAgent) — actionable cost waste",
      "difficulty": "medium",
      "prompt_file": "prompts/ec2-overprovisioned-high-confidence.md",
      "baseline_file": "baselines/ec2-overprovisioned-high-confidence.md",
      "expected_verdict": "UNDERUTILIZED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNDERUTILIZED", "ec2-overprovisioned-high-confidence", "VERDICT", "REASON", "REMEDIATION", "Overprovisioned"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NOT_OPTIMIZED"]
        }
      ]
    },
    {
      "id": "ec2-underprovisioned-cpu-memory",
      "name": "EC2 Underprovisioned — CPU 97% and Memory 92%, performance risk",
      "difficulty": "medium",
      "prompt_file": "prompts/ec2-underprovisioned-cpu-memory.md",
      "baseline_file": "baselines/ec2-underprovisioned-cpu-memory.md",
      "expected_verdict": "NOT_OPTIMIZED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NOT_OPTIMIZED", "ec2-underprovisioned-cpu-memory", "VERDICT", "REASON", "REMEDIATION", "Underprovisioned"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNDERUTILIZED"]
        }
      ]
    },
    {
      "id": "ebs-volume-optimized",
      "name": "EBS gp3 volume Optimized — no action needed",
      "difficulty": "easy",
      "prompt_file": "prompts/ebs-volume-optimized.md",
      "baseline_file": "baselines/ebs-volume-optimized.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "ebs-volume-optimized", "VERDICT", "REASON", "REMEDIATION", "Optimized"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NOT_OPTIMIZED", "VERDICT: UNDERUTILIZED"]
        }
      ]
    },
    {
      "id": "lambda-overprovisioned-memory",
      "name": "Lambda Overprovisioned — 2560MB allocated but 400MB avg usage",
      "difficulty": "medium",
      "prompt_file": "prompts/lambda-overprovisioned-memory.md",
      "baseline_file": "baselines/lambda-overprovisioned-memory.md",
      "expected_verdict": "UNDERUTILIZED",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNDERUTILIZED", "lambda-overprovisioned-memory", "VERDICT", "REASON", "REMEDIATION", "Overprovisioned"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NOT_OPTIMIZED"]
        }
      ]
    },
    {
      "id": "ec2-overprovisioned-low-confidence-inferred-memory",
      "name": "EC2 Overprovisioned but LOW confidence — inferred memory, performanceRisk 4",
      "difficulty": "hard",
      "prompt_file": "prompts/ec2-overprovisioned-low-confidence-inferred-memory.md",
      "baseline_file": "baselines/ec2-overprovisioned-low-confidence-inferred-memory.md",
      "expected_verdict": "NOT_OPTIMIZED",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NOT_OPTIMIZED", "ec2-overprovisioned-low-confidence", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNDERUTILIZED"]
        }
      ]
    },
    {
      "id": "ec2-optimized-clean",
      "name": "EC2 Optimized with full metrics — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/ec2-optimized-clean.md",
      "baseline_file": "baselines/ec2-optimized-clean.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "ec2-optimized-clean", "VERDICT", "REASON", "REMEDIATION", "Optimized"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NOT_OPTIMIZED", "VERDICT: UNDERUTILIZED"]
        }
      ]
    }
  ]
}
