      "prompt_file": "prompts/manual-gap-custom-resource.md",
      "baseline_file": "baselines/manual-gap-custom-resource.md",
      "expected_verdict": "MANUAL_STEP_REQUIRED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
