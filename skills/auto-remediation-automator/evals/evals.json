{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "auto-remediation-automator",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Auto-Remediation Automator. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "s3-public-access-auto",
      "name": "S3 public-read finding with AWS-DisableS3BucketPublicAccess — AUTOMATED, automatic trigger",
      "difficulty": "easy",
      "prompt_file": "prompts/s3-public-access-auto.md",
      "baseline_file": "baselines/s3-public-access-auto.md",
      "expected_verdict": "AUTOMATED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATED", "s3-public-access-auto", "AWS-DisableS3BucketPublicAccess", "VERDICT", "TRIGGER", "TEMPLATE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: MANUAL_STEP_REQUIRED"]
        }
      ]
    },
    {
      "id": "iam-unused-key-revoke",
      "name": "IAM unused access key — AWS-IAMRevokeUnusedAccessKey, AUTOMATED with audit",
      "difficulty": "medium",
