{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "s3-access-troubleshooter",
  "version": "1.0.0",
  "description": "Structured eval definitions for the S3 Access Troubleshooter. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "getobject-arn-shape-wrong",
      "name": "GetObject AccessDenied because identity policy has s3:GetObject on bucket ARN instead of object ARN",
      "difficulty": "easy",
      "prompt_file": "prompts/getobject-arn-shape-wrong.md",
      "baseline_file": "baselines/getobject-arn-shape-wrong.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "ROOT_CAUSE_FOUND", "ROOT_CAUSE", "object ARN", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "KMS"]
        }
      ]
    },
    {
      "id": "cross-account-kms-decrypt",
      "name": "Cross-account GetObject on SSE-KMS object — KMS key policy missing caller role",
      "difficulty": "hard",
      "prompt_file": "prompts/cross-account-kms-decrypt.md",
      "baseline_file": "baselines/cross-account-kms-decrypt.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "ROOT_CAUSE_FOUND", "KMS", "cross-account", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "bucket ARN"]
        }
      ]
    },
    {
      "id": "listbucket-arn-shape-wrong",
      "name": "ListBucket AccessDenied because identity policy has s3:ListBucket on object ARN instead of bucket ARN",
      "difficulty": "medium",
      "prompt_file": "prompts/listbucket-arn-shape-wrong.md",
      "baseline_file": "baselines/listbucket-arn-shape-wrong.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "ROOT_CAUSE_FOUND", "bucket ARN", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "KMS", "VERDICT: NEED_MORE_INFO"]
        }
      ]
    },
    {
      "id": "putobject-sse-enforcement-deny",
      "name": "PutObject AccessDenied because bucket policy denies PutObject without SSE-KMS header",
      "difficulty": "medium",
      "prompt_file": "prompts/putobject-sse-enforcement-deny.md",
      "baseline_file": "baselines/putobject-sse-enforcement-deny.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "ROOT_CAUSE_FOUND", "SSE", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "object ARN"]
        }
      ]
    },
    {
      "id": "insufficient-context-need-more-info",
      "name": "Bare AccessDenied report without CloudTrail or policy details — must request more info",
      "difficulty": "easy",
      "prompt_file": "prompts/insufficient-context-need-more-info.md",
      "baseline_file": "baselines/insufficient-context-need-more-info.md",
      "expected_verdict": "NEED_MORE_INFO",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "NEED_MORE_INFO", "CloudTrail"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "ROOT_CAUSE_FOUND", "ESCALATE"]
        }
      ]
    }
  ]
}
