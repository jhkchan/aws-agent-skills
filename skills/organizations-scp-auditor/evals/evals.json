{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "organizations-scp-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Organizations SCP Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "permissive-scp-no-leave-deny",
      "name": "Deny-list mode with no LeaveOrganization deny and no security-service deny — full SCP bypass path",
      "difficulty": "medium",
      "prompt_file": "prompts/permissive-scp-no-leave-deny.md",
      "baseline_file": "baselines/permissive-scp-no-leave-deny.md",
      "expected_verdict": "PERMISSIVE_SCP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PERMISSIVE_SCP", "permissive-scp-no-leave-deny", "VERDICT", "REASON", "REMEDIATION", "LeaveOrganization"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: MISSING_GUARDRAIL"]
        }
      ]
    },
    {
      "id": "permissive-scp-security-service-disable",
      "name": "LeaveOrganization denied but security-service disruption not denied — attacker can blind detection",
      "difficulty": "hard",
      "prompt_file": "prompts/permissive-scp-security-service-disable.md",
      "baseline_file": "baselines/permissive-scp-security-service-disable.md",
      "expected_verdict": "PERMISSIVE_SCP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PERMISSIVE_SCP", "permissive-scp-security-service-disable", "VERDICT", "REASON", "REMEDIATION", "guardduty"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: MISSING_GUARDRAIL"]
        }
      ]
    },
    {
      "id": "missing-guardrail-no-region-lock",
      "name": "Critical guardrails present but no aws:RequestedRegion region restriction for regulated-data OU",
      "difficulty": "hard",
      "prompt_file": "prompts/missing-guardrail-no-region-lock.md",
      "baseline_file": "baselines/missing-guardrail-no-region-lock.md",
      "expected_verdict": "MISSING_GUARDRAIL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MISSING_GUARDRAIL", "missing-guardrail-no-region-lock", "VERDICT", "REASON", "REMEDIATION", "RequestedRegion"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: PERMISSIVE_SCP"]
        }
      ]
    },
    {
      "id": "config-gap-fullawsaccess-detached-no-allow",
      "name": "FullAWSAccess detached from root with no Allow-list replacement — all access blocked",
      "difficulty": "medium",
      "prompt_file": "prompts/config-gap-fullawsaccess-detached-no-allow.md",
      "baseline_file": "baselines/config-gap-fullawsaccess-detached-no-allow.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "config-gap-fullawsaccess-detached-no-allow", "VERDICT", "REASON", "REMEDIATION", "FullAWSAccess"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PERMISSIVE_SCP", "VERDICT: MISSING_GUARDRAIL"]
        }
      ]
    },
    {
      "id": "config-gap-unsupported-condition-key",
      "name": "SCP Deny using kms:ViaService — service-specific key silently unsupported, Deny never applies",
      "difficulty": "hard",
      "prompt_file": "prompts/config-gap-unsupported-condition-key.md",
      "baseline_file": "baselines/config-gap-unsupported-condition-key.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "config-gap-unsupported-condition-key", "VERDICT", "REASON", "REMEDIATION", "kms:ViaService"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PERMISSIVE_SCP", "VERDICT: MISSING_GUARDRAIL"]
        }
      ]
    },
    {
      "id": "ok-deny-list-strategy",
      "name": "Proper deny-list strategy with LeaveOrganization + security-service + region-restriction guardrails — clean",
      "difficulty": "easy",
      "prompt_file": "prompts/ok-deny-list-strategy.md",
      "baseline_file": "baselines/ok-deny-list-strategy.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "ok-deny-list-strategy", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PERMISSIVE_SCP", "VERDICT: CONFIG_GAP", "VERDICT: MISSING_GUARDRAIL"]
        }
      ]
    }
  ]
}
