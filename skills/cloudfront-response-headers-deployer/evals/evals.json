      "baseline_file": "baselines/cors-wildcard-with-credentials-missing.md",
      "expected_verdict": "PREREQUISITES_MISSING",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PREREQUISITES_MISSING", "credentials", "VERDICT"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: READY_TO_DEPLOY"]
        }
      ]
    },
    {
      "id": "managed-securityheaders-policy-ready",
