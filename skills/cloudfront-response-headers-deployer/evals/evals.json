      "baseline_file": "baselines/managed-securityheaders-policy-ready.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "0857826db9cffff310d5ad62955c9c26", "VERDICT", "SecurityHeadersPolicy"]
