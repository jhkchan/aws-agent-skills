{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "cloudfront-response-headers-deployer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the CloudFront Response Headers Deployer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "custom-security-headers-ready",
      "name": "Custom security headers + CORS policy on Deployed distribution — all requirements satisfied (READY_TO_DEPLOY)",
      "difficulty": "easy",
      "prompt_file": "prompts/custom-security-headers-ready.md",
      "baseline_file": "baselines/custom-security-headers-ready.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "prod-security-headers-policy", "VERDICT", "Content-Security-Policy"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
      "id": "cors-wildcard-with-credentials-missing",
