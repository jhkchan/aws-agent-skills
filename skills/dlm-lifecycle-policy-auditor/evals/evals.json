{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "dlm-lifecycle-policy-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the DLM Lifecycle Policy Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "no-policy-at-all",
      "name": "Account with production EBS volumes but zero DLM policies — no automated backup",
      "difficulty": "medium",
      "prompt_file": "prompts/no-policy-at-all.md",
      "baseline_file": "baselines/no-policy-at-all.md",
      "expected_verdict": "NO_POLICY",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_POLICY", "no-policy-at-all", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: MISCONFIGURED", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "disabled-policy",
      "name": "Well-formed DLM policy in State DISABLED — zero snapshots created",
      "difficulty": "easy",
      "prompt_file": "prompts/disabled-policy.md",
      "baseline_file": "baselines/disabled-policy.md",
      "expected_verdict": "MISCONFIGURED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MISCONFIGURED", "disabled-policy", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_POLICY", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "empty-target-tags",
      "name": "Enabled DLM policy with empty TargetTags — no volumes match",
      "difficulty": "medium",
      "prompt_file": "prompts/empty-target-tags.md",
      "baseline_file": "baselines/empty-target-tags.md",
      "expected_verdict": "MISCONFIGURED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MISCONFIGURED", "empty-target-tags", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_POLICY", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "no-cross-region-copy-gap",
      "name": "Valid enabled DLM policy with no CrossRegionCopyTargets — no DR posture",
      "difficulty": "hard",
      "prompt_file": "prompts/no-cross-region-copy-gap.md",
      "baseline_file": "baselines/no-cross-region-copy-gap.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "no-cross-region-copy-gap", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: MISCONFIGURED", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "short-retention-no-copy-tags-gap",
      "name": "Enabled DLM policy with Count:1 retention and CopyTags:false — weak recovery + metadata loss",
      "difficulty": "hard",
      "prompt_file": "prompts/short-retention-no-copy-tags-gap.md",
      "baseline_file": "baselines/short-retention-no-copy-tags-gap.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "short-retention-no-copy-tags-gap", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: MISCONFIGURED", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "clean-production-policy",
      "name": "Enabled DLM policy with 6-field cron, 30-day retention, DR copy with explicit CMK — clean",
      "difficulty": "easy",
      "prompt_file": "prompts/clean-production-policy.md",
      "baseline_file": "baselines/clean-production-policy.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "clean-production-policy", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: MISCONFIGURED", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
