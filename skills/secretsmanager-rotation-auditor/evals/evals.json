{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "secretsmanager-rotation-auditor",
  "version": "1.0.0",
  "snapshot_date": "2026-08-04",
  "description": "Structured eval definitions for the Secrets Manager Rotation Auditor. Six-secret proven set exercising every branch of the classification logic: UNROTATED (no rotation), OK (healthy rotation), ROTATION_BROKEN (Lambda deleted, never rotated with target deleted, permission chain broken), STALE (overdue but Lambda active), and recovery-window flagged. Each eval maps to a prompt file and a baseline (no-skill) file for with-skill-vs-baseline comparison.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "unrotated-rds-secret",
      "name": "RDS PostgreSQL secret with no rotation — static DB password",
      "difficulty": "easy",
      "branch": "Step 2 — rotation not enabled (CRITICAL for RDS)",
      "prompt_file": "prompts/unrotated-rds-secret.md",
      "baseline_file": "baselines/unrotated-rds-secret.md",
      "expected_verdict": "UNROTATED",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNROTATED", "prod-rds-postgres-credentials", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: STALE", "VERDICT: ROTATION_BROKEN"]
        }
      ]
    },
    {
      "id": "ok-healthy-rotation",
      "name": "RDS MySQL secret with healthy rotation — Lambda active, recent rotation within interval",
      "difficulty": "easy",
      "branch": "Step 8 — all checks pass (within schedule, Lambda healthy)",
      "prompt_file": "prompts/ok-healthy-rotation.md",
      "baseline_file": "baselines/ok-healthy-rotation.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "staging-rds-mysql-credentials", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: UNROTATED", "VERDICT: STALE", "VERDICT: ROTATION_BROKEN"]
        }
      ]
    },
    {
      "id": "broken-lambda-deleted",
      "name": "Redshift secret with rotation enabled but Lambda function deleted — silent rotation failure",
      "difficulty": "medium",
      "branch": "Step 3b — Lambda deleted (404), every rotation silently fails",
      "prompt_file": "prompts/broken-lambda-deleted.md",
      "baseline_file": "baselines/broken-lambda-deleted.md",
      "expected_verdict": "ROTATION_BROKEN",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROTATION_BROKEN", "analytics-redshift-credentials", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: STALE", "VERDICT: UNROTATED"]
        }
      ]
    },
    {
      "id": "stale-overdue-rotation",
      "name": "DocDB secret with rotation enabled and Lambda healthy but 95 days overdue (interval 30)",
      "difficulty": "medium",
      "branch": "Step 7c — overdue_ratio > 2.0 (STALE, HIGH risk)",
      "prompt_file": "prompts/stale-overdue-rotation.md",
      "baseline_file": "baselines/stale-overdue-rotation.md",
      "expected_verdict": "STALE",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["STALE", "documentdb-cluster-credentials", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNROTATED", "VERDICT: ROTATION_BROKEN"]
        }
      ]
    },
    {
      "id": "broken-never-rotated",
      "name": "Oracle RDS secret — rotation enabled 90 days ago, null LastRotatedDate, Lambda erroring on deleted target",
      "difficulty": "hard",
      "branch": "Step 7a — null LastRotatedDate, enabled >1 interval (ROTATION_BROKEN, not OK)",
      "prompt_file": "prompts/broken-never-rotated.md",
      "baseline_file": "baselines/broken-never-rotated.md",
      "expected_verdict": "ROTATION_BROKEN",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROTATION_BROKEN", "legacy-oracle-credentials", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: STALE", "VERDICT: UNROTATED"]
        }
      ]
    },
    {
      "id": "recovery-window-flagged",
      "name": "API token secret in recovery window with no rotation — UNROTATED plus DELETION_FLAG",
      "difficulty": "hard",
      "branch": "Step 1 + Step 2 — recovery window flag + UNROTATED",
      "prompt_file": "prompts/recovery-window-flagged.md",
      "baseline_file": "baselines/recovery-window-flagged.md",
      "expected_verdict": "UNROTATED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNROTATED", "payment-gateway-api-token", "VERDICT", "REASON", "REMEDIATION", "DELETION_FLAG"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: STALE", "VERDICT: ROTATION_BROKEN"]
        }
      ]
    }
  ]
}
