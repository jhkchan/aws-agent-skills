{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "billing-account-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Billing Account Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "root-billing-only-no-mfa",
      "name": "Root MFA disabled and IAM billing access deactivated — root-only billing with unprotected root",
      "difficulty": "hard",
      "prompt_file": "prompts/root-billing-only-no-mfa.md",
      "baseline_file": "baselines/root-billing-only-no-mfa.md",
      "expected_verdict": "ROOT_BILLING",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_BILLING", "root-billing-only-no-mfa", "VERDICT", "REASON", "REMEDIATION", "AccountMFAEnabled"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ANOMALY_DETECTION", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "root-access-keys-present",
      "name": "Root access keys present on otherwise clean account — MFA-bypassing billing backdoor",
      "difficulty": "hard",
      "prompt_file": "prompts/root-access-keys-present.md",
      "baseline_file": "baselines/root-access-keys-present.md",
      "expected_verdict": "ROOT_BILLING",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_BILLING", "root-access-keys-present", "VERDICT", "REASON", "REMEDIATION", "AccountAccessKeysPresent"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ANOMALY_DETECTION", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "no-anomaly-detection",
      "name": "Root secured and billing delegated but no Cost Anomaly Detection — cost spikes undetected",
      "difficulty": "medium",
      "prompt_file": "prompts/no-anomaly-detection.md",
      "baseline_file": "baselines/no-anomaly-detection.md",
      "expected_verdict": "NO_ANOMALY_DETECTION",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ANOMALY_DETECTION", "no-anomaly-detection", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: ROOT_BILLING", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "config-gap-no-budgets",
      "name": "CAD and free-tier alerts on but zero billing budgets — no spend guardrails",
      "difficulty": "easy",
      "prompt_file": "prompts/config-gap-no-budgets.md",
      "baseline_file": "baselines/config-gap-no-budgets.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "config-gap-no-budgets", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: ROOT_BILLING", "VERDICT: NO_ANOMALY_DETECTION"]
        }
      ]
    },
    {
      "id": "config-gap-freetier-alerts-off",
      "name": "Everything configured but free-tier usage alerts disabled — surprise charges possible",
      "difficulty": "easy",
      "prompt_file": "prompts/config-gap-freetier-alerts-off.md",
      "baseline_file": "baselines/config-gap-freetier-alerts-off.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "config-gap-freetier-alerts-off", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: ROOT_BILLING", "VERDICT: NO_ANOMALY_DETECTION"]
        }
      ]
    },
    {
      "id": "all-configured-ok",
      "name": "Fully configured account — root secured, billing delegated, CAD + budgets + free-tier alerts on",
      "difficulty": "easy",
      "prompt_file": "prompts/all-configured-ok.md",
      "baseline_file": "baselines/all-configured-ok.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "all-configured-ok", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: ROOT_BILLING", "VERDICT: NO_ANOMALY_DETECTION", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
