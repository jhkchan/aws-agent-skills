{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "ecr-repository-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the ECR Repository Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "public-pull-wildcard-no-condition",
      "name": "Wildcard Principal pull with no condition — any account can pull image layers",
      "difficulty": "easy",
      "prompt_file": "prompts/public-pull-wildcard-no-condition.md",
      "baseline_file": "baselines/public-pull-wildcard-no-condition.md",
      "expected_verdict": "PUBLIC",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC", "public-pull-wildcard-no-condition", "VERDICT", "REASON", "REMEDIATION", "Principal"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_SCAN", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "scan-off-unscanned-images",
      "name": "scanOnPush false with unscanned images — vulnerability blind spot",
      "difficulty": "medium",
      "prompt_file": "prompts/scan-off-unscanned-images.md",
      "baseline_file": "baselines/scan-off-unscanned-images.md",
      "expected_verdict": "NO_SCAN",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_SCAN", "scan-off-unscanned-images", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PUBLIC", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "no-lifecycle-policy",
      "name": "No lifecycle policy — unbounded image accumulation and cost growth",
      "difficulty": "medium",
      "prompt_file": "prompts/no-lifecycle-policy.md",
      "baseline_file": "baselines/no-lifecycle-policy.md",
      "expected_verdict": "NO_LIFECYCLE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_LIFECYCLE", "no-lifecycle-policy", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PUBLIC", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "tag-mutable-config-gap",
      "name": "Tag mutability MUTABLE — supply-chain tag overwrite risk",
      "difficulty": "easy",
      "prompt_file": "prompts/tag-mutable-config-gap.md",
      "baseline_file": "baselines/tag-mutable-config-gap.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "tag-mutable-config-gap", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PUBLIC", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "clean-ok",
      "name": "All dimensions clean — same-account policy, scan on, lifecycle present, immutable tags",
      "difficulty": "easy",
      "prompt_file": "prompts/clean-ok.md",
      "baseline_file": "baselines/clean-ok.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "clean-ok", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PUBLIC", "VERDICT: NO_SCAN"]
        }
      ]
    },
    {
      "id": "public-pull-sourcevpce-scoped-config-gap",
      "name": "Wildcard Principal pull restricted by aws:SourceVpce — downgraded to CONFIG_GAP",
      "difficulty": "hard",
      "prompt_file": "prompts/public-pull-sourcevpce-scoped-config-gap.md",
      "baseline_file": "baselines/public-pull-sourcevpce-scoped-config-gap.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "public-pull-sourcevpce-scoped-config-gap", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PUBLIC", "VERDICT: OK"]
        }
      ]
    }
  ]
}
