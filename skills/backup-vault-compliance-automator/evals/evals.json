{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "backup-vault-compliance-automator",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Backup Vault Compliance Automator. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "vault-lock-compliance-mode",
      "name": "Vault Lock compliance mode deployment — SEC 17a-4, 7-year immutable retention",
      "difficulty": "hard",
      "prompt_file": "prompts/vault-lock-compliance-mode.md",
      "baseline_file": "baselines/vault-lock-compliance-mode.md",
      "expected_verdict": "AUTOMATION_DEPLOYED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATION_DEPLOYED", "vault-lock-compliance-mode", "COMPLIANCE", "2557", "VERDICT", "TEMPLATE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: REVIEW_REQUIRED"]
        }
      ]
    },
    {
      "id": "vault-policy-enforcement",
      "name": "Vault policy enforcement — deny non-encrypted, KMS key, cross-account",
      "difficulty": "medium",
      "prompt_file": "prompts/vault-policy-enforcement.md",
      "baseline_file": "baselines/vault-policy-enforcement.md",
      "expected_verdict": "AUTOMATION_DEPLOYED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATION_DEPLOYED", "vault-policy-enforcement", "DenyUnencryptedBackups", "VERDICT", "TEMPLATE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: REVIEW_REQUIRED"]
        }
      ]
    },
    {
      "id": "backup-coverage-audit",
      "name": "Backup coverage audit — 3 EC2 instances without backup plan tag",
      "difficulty": "medium",
      "prompt_file": "prompts/backup-coverage-audit.md",
      "baseline_file": "baselines/backup-coverage-audit.md",
      "expected_verdict": "REVIEW_REQUIRED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["REVIEW_REQUIRED", "backup-coverage-audit", "VERDICT", "GAP", "coverage"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: AUTOMATION_DEPLOYED"]
        }
      ]
    },
    {
      "id": "cross-region-verification",
      "name": "Cross-region replication verification — us-east-1 to us-west-2",
      "difficulty": "hard",
      "prompt_file": "prompts/cross-region-verification.md",
      "baseline_file": "baselines/cross-region-verification.md",
      "expected_verdict": "AUTOMATION_DEPLOYED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATION_DEPLOYED", "cross-region-verification", "us-west-2", "VERDICT", "REPLICATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: REVIEW_REQUIRED"]
        }
      ]
    },
    {
      "id": "config-rule-compliance",
      "name": "Config rules for backup compliance — Organizations fleet rollout",
      "difficulty": "hard",
      "prompt_file": "prompts/config-rule-compliance.md",
      "baseline_file": "baselines/config-rule-compliance.md",
      "expected_verdict": "AUTOMATION_DEPLOYED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATION_DEPLOYED", "config-rule-compliance", "Config", "aggregator", "VERDICT", "TEMPLATE"]
