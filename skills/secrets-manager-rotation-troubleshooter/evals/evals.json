{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "secrets-manager-rotation-troubleshooter",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Secrets Manager Rotation Troubleshooter. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "rotation-lambda-vpc-timeout",
      "name": "Rotation Lambda not VPC-attached; cannot reach private RDS Aurora PostgreSQL — times out at 15s on every rotation",
      "difficulty": "hard",
      "prompt_file": "prompts/rotation-lambda-vpc-timeout.md",
      "baseline_file": "baselines/rotation-lambda-vpc-timeout.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_layer": "ROTATION_LAMBDA_VPC",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "rotation-lambda-vpc-timeout", "ROTATION_LAMBDA_VPC", "VERDICT", "REASON", "EVIDENCE", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "VERDICT: ESCALATE", "LAYER: ROTATION_LAMBDA_TIMEOUT"]
        }
      ]
    },
    {
      "id": "eventbridge-schedule-deleted",
      "name": "Secret rotation never triggers — EventBridge rule was deleted during a CloudEvents cleanup; LastRotatedDate 14 days stale",
      "difficulty": "hard",
      "prompt_file": "prompts/eventbridge-schedule-deleted.md",
      "baseline_file": "baselines/eventbridge-schedule-deleted.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_layer": "SCHEDULE_MISSING",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "eventbridge-schedule-deleted", "SCHEDULE_MISSING", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "LAYER: SCHEDULE_DISABLED"]
        }
      ]
    },
    {
      "id": "master-secret-arn-misconfigured",
      "name": "Rotation Lambda env var points at a Master Secret ARN that was deleted; createSecret fails with ResourceNotFoundException",
      "difficulty": "hard",
      "prompt_file": "prompts/master-secret-arn-misconfigured.md",
      "baseline_file": "baselines/master-secret-arn-misconfigured.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_layer": "MASTER_SECRET_MISCONFIGURED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "master-secret-arn-misconfigured", "MASTER_SECRET_MISCONFIGURED", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "LAYER: PERMISSION_ROTATION_ROLE"]
        }
      ]
    },
    {
      "id": "cross-account-secret-access-denied",
      "name": "Cross-account rotation Lambda in account 222222222222 denied reading secret in account 111111111111 — resource policy lists same-account role only",
      "difficulty": "hard",
      "prompt_file": "prompts/cross-account-secret-access-denied.md",
      "baseline_file": "baselines/cross-account-secret-access-denied.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_layer": "PERMISSION_CROSS_ACCOUNT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "cross-account-secret-access-denied", "PERMISSION_CROSS_ACCOUNT", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "LAYER: PERMISSION_ROTATION_ROLE"]
        }
      ]
    },
    {
      "id": "alternating-users-strategy-conflict",
      "name": "Rotation Lambda re-deployed with Single User template over a secret wired for Alternating Users — ALTER USER on self fails with SUPER privilege required",
      "difficulty": "hard",
      "prompt_file": "prompts/alternating-users-strategy-conflict.md",
      "baseline_file": "baselines/alternating-users-strategy-conflict.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_layer": "STRATEGY_CONFLICT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "alternating-users-strategy-conflict", "STRATEGY_CONFLICT", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "LAYER: SUPERUSER_INSUFFICIENT"]
        }
      ]
    }
  ]
}
