{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "sagemaker-endpoint-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the SageMaker Endpoint Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "public-endpoint-no-vpc",
      "name": "Endpoint with no VpcConfig on the Model — internet-facing invocation API",
      "difficulty": "medium",
      "prompt_file": "prompts/public-endpoint-no-vpc.md",
      "baseline_file": "baselines/public-endpoint-no-vpc.md",
      "expected_verdict": "PUBLIC_ENDPOINT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC_ENDPOINT", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "no-kms-encryption",
      "name": "VPC-attached endpoint with no KmsKeyId and inter-container encryption disabled on a pipeline",
      "difficulty": "medium",
      "prompt_file": "prompts/no-kms-encryption.md",
      "baseline_file": "baselines/no-kms-encryption.md",
      "expected_verdict": "NO_ENCRYPTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ENCRYPTION", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_ENDPOINT"]
        }
      ]
    },
    {
      "id": "overpermissive-execution-role",
      "name": "VPC-attached encrypted endpoint with admin wildcard execution role",
      "difficulty": "medium",
      "prompt_file": "prompts/overpermissive-execution-role.md",
      "baseline_file": "baselines/overpermissive-execution-role.md",
      "expected_verdict": "OVERPERMISSIVE_ROLE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OVERPERMISSIVE_ROLE", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_ENDPOINT"]
        }
      ]
    },
    {
      "id": "no-monitoring-no-capture",
      "name": "Encrypted VPC endpoint with scoped role but no data capture and no monitoring schedule",
      "difficulty": "hard",
      "prompt_file": "prompts/no-monitoring-no-capture.md",
      "baseline_file": "baselines/no-monitoring-no-capture.md",
      "expected_verdict": "NO_MONITORING",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_MONITORING", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_ENDPOINT"]
        }
      ]
    },
    {
      "id": "config-gap-single-instance",
      "name": "Fully hardened endpoint except single instance — no high availability",
      "difficulty": "easy",
      "prompt_file": "prompts/config-gap-single-instance.md",
      "baseline_file": "baselines/config-gap-single-instance.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_ENDPOINT"]
        }
      ]
    },
    {
      "id": "ok-hardened-endpoint",
      "name": "Fully hardened endpoint — VPC, KMS, scoped role, monitoring, multi-instance HA",
      "difficulty": "easy",
      "prompt_file": "prompts/ok-hardened-endpoint.md",
      "baseline_file": "baselines/ok-hardened-endpoint.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PUBLIC_ENDPOINT", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    }
  ]
}
