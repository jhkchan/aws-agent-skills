{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "stepfunctions-statemachine-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Step Functions State Machine Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "no-logging-standard-workflow",
      "name": "Standard workflow with LoggingConfiguration.level OFF — no durable per-state log delivery",
      "difficulty": "easy",
      "prompt_file": "prompts/no-logging-standard-workflow.md",
      "baseline_file": "baselines/no-logging-standard-workflow.md",
      "expected_verdict": "NO_LOGGING",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "REASON", "REMEDIATION", "NO_LOGGING", "OFF"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: OVERPERMISSIVE_ROLE", "VERDICT: NO_TRACING"]
        }
      ]
    },
    {
      "id": "no-tracing-standard-workflow",
      "name": "Standard workflow with logging ALL but TracingConfiguration.enabled false — no distributed tracing",
      "difficulty": "easy",
      "prompt_file": "prompts/no-tracing-standard-workflow.md",
      "baseline_file": "baselines/no-tracing-standard-workflow.md",
      "expected_verdict": "NO_TRACING",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "REASON", "REMEDIATION", "NO_TRACING"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_LOGGING", "VERDICT: OVERPERMISSIVE_ROLE"]
        }
      ]
    },
    {
      "id": "over-permissive-execution-role",
      "name": "Standard workflow with logging + tracing but execution role grants Action * on Resource * — admin-equivalent blast radius",
      "difficulty": "medium",
      "prompt_file": "prompts/over-permissive-execution-role.md",
      "baseline_file": "baselines/over-permissive-execution-role.md",
      "expected_verdict": "OVERPERMISSIVE_ROLE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "REASON", "REMEDIATION", "OVERPERMISSIVE_ROLE", "wildcard"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_LOGGING", "VERDICT: NO_TRACING"]
        }
      ]
    },
    {
      "id": "missing-error-handling-config-gap",
      "name": "Standard workflow with logging + tracing + scoped role but Lambda Task has no Catch and no Retry — any transient error fails the execution",
      "difficulty": "medium",
      "prompt_file": "prompts/missing-error-handling-config-gap.md",
      "baseline_file": "baselines/missing-error-handling-config-gap.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "REASON", "REMEDIATION", "CONFIG_GAP"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: OVERPERMISSIVE_ROLE"]
        }
      ]
    },
    {
      "id": "all-clean-ok",
      "name": "Standard workflow with logging ALL + includeExecutionData, tracing enabled, scoped role, and hardened ASL — all dimensions pass",
      "difficulty": "easy",
      "prompt_file": "prompts/all-clean-ok.md",
      "baseline_file": "baselines/all-clean-ok.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "REASON", "REMEDIATION", "VERDICT: OK"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_LOGGING", "VERDICT: NO_TRACING", "VERDICT: OVERPERMISSIVE_ROLE", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "express-tracing-noop",
      "name": "Express workflow with TracingConfiguration.enabled true (silently ignored on Express) — operator believes tracing works but no X-Ray traces are produced",
      "difficulty": "hard",
      "prompt_file": "prompts/express-tracing-noop.md",
      "baseline_file": "baselines/express-tracing-noop.md",
      "expected_verdict": "NO_TRACING",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "REASON", "REMEDIATION", "NO_TRACING", "EXPRESS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_LOGGING"]
        }
      ]
    }
  ]
}
