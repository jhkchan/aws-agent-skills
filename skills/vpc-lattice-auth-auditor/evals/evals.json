{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "vpc-lattice-auth-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the VPC Lattice Auth Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "no-auth-policy-default-open",
      "name": "Service network with no auth policy — default-open within associated VPCs",
      "difficulty": "easy",
      "prompt_file": "prompts/no-auth-policy-default-open.md",
      "baseline_file": "baselines/no-auth-policy-default-open.md",
      "expected_verdict": "NO_AUTH_POLICY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_AUTH_POLICY", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PUBLIC_SERVICE_NETWORK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "public-service-network-wildcard",
      "name": "Auth policy with Principal * and vpc-lattice:* — any AWS principal can invoke",
      "difficulty": "easy",
      "prompt_file": "prompts/public-service-network-wildcard.md",
      "baseline_file": "baselines/public-service-network-wildcard.md",
      "expected_verdict": "PUBLIC_SERVICE_NETWORK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC_SERVICE_NETWORK", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: NO_AUTH_POLICY"]
        }
      ]
    },
    {
      "id": "cross-account-invoke-no-condition",
      "name": "Cross-account vpc-lattice:Invoke with no restrictive condition — external invoke exposure",
      "difficulty": "medium",
      "prompt_file": "prompts/cross-account-invoke-no-condition.md",
      "baseline_file": "baselines/cross-account-invoke-no-condition.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_AUTH_POLICY", "VERDICT: PUBLIC_SERVICE_NETWORK"]
        }
      ]
    },
    {
      "id": "cross-account-invoke-source-account",
      "name": "Cross-account Invoke restricted by aws:SourceAccount — scoped but fragile cross-account dependency",
      "difficulty": "hard",
      "prompt_file": "prompts/cross-account-invoke-source-account.md",
      "baseline_file": "baselines/cross-account-invoke-source-account.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_AUTH_POLICY", "VERDICT: PUBLIC_SERVICE_NETWORK"]
        }
      ]
    },
    {
      "id": "same-account-source-vpc-ok",
      "name": "Same-account Invoke scoped by aws:SourceVpc with clean target groups — secure posture",
      "difficulty": "easy",
      "prompt_file": "prompts/same-account-source-vpc-ok.md",
      "baseline_file": "baselines/same-account-source-vpc-ok.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_AUTH_POLICY", "VERDICT: PUBLIC_SERVICE_NETWORK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "public-notaction-inverse-wildcard",
      "name": "Principal * with NotAction inverse wildcard — silent Invoke exposure via inverse grant",
      "difficulty": "hard",
      "prompt_file": "prompts/public-notaction-inverse-wildcard.md",
      "baseline_file": "baselines/public-notaction-inverse-wildcard.md",
      "expected_verdict": "PUBLIC_SERVICE_NETWORK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC_SERVICE_NETWORK", "VERDICT", "REASON", "FINDINGS", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: NO_AUTH_POLICY"]
        }
      ]
    }
  ]
}
