{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "autoscaling-policy-deployer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Auto Scaling Policy Deployer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "target-tracking-cpu-ready",
      "name": "Target tracking on CPUUtilization for a healthy multi-AZ web ASG — all dimensions pass",
      "difficulty": "easy",
      "prompt_file": "prompts/target-tracking-cpu-ready.md",
      "baseline_file": "baselines/target-tracking-cpu-ready.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "target-tracking-cpu-ready", "VERDICT", "CHECKLIST", "VERIFICATION_COMMANDS", "TargetTrackingScaling", "ASGAverageCPUUtilization"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
      "id": "dual-policy-conflict-missing",
      "name": "Target tracking and step scaling both on CPU — dual-policy trap (PREREQUISITES_MISSING)",
      "difficulty": "hard",
      "prompt_file": "prompts/dual-policy-conflict-missing.md",
      "baseline_file": "baselines/dual-policy-conflict-missing.md",
      "expected_verdict": "PREREQUISITES_MISSING",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PREREQUISITES_MISSING", "dual-policy-conflict-missing", "VERDICT", "dual-policy"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: READY_TO_DEPLOY"]
        }
      ]
    },
    {
      "id": "predictive-scaling-no-history-missing",
