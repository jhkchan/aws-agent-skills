{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "lambda-runtime-deprecation-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Lambda Runtime Deprecation Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "deprecated-python39-clean-config",
      "name": "python3.9 runtime with otherwise clean config — deprecated time bomb",
      "difficulty": "medium",
      "prompt_file": "prompts/deprecated-python39-clean-config.md",
      "baseline_file": "baselines/deprecated-python39-clean-config.md",
      "expected_verdict": "DEPRECATED_RUNTIME",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["DEPRECATED_RUNTIME", "deprecated-python39-clean-config", "VERDICT", "REASON", "REMEDIATION", "python3.9"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: OVERPERMISSIVE"]
        }
      ]
    },
    {
      "id": "admin-wildcard-role-nodejs20",
      "name": "nodejs20.x with admin wildcard execution role — privilege escalation springboard",
      "difficulty": "easy",
      "prompt_file": "prompts/admin-wildcard-role-nodejs20.md",
      "baseline_file": "baselines/admin-wildcard-role-nodejs20.md",
      "expected_verdict": "OVERPERMISSIVE",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OVERPERMISSIVE", "admin-wildcard-role-nodejs20", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DEPRECATED_RUNTIME"]
        }
      ]
    },
    {
      "id": "public-function-url-python312",
      "name": "python3.12 with Function URL AuthType NONE — publicly invocable",
      "difficulty": "medium",
      "prompt_file": "prompts/public-function-url-python312.md",
      "baseline_file": "baselines/public-function-url-python312.md",
      "expected_verdict": "PUBLIC_EXPOSURE",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PUBLIC_EXPOSURE", "public-function-url-python312", "VERDICT", "REASON", "REMEDIATION", "NONE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "missing-tracing-nodejs20",
      "name": "nodejs20.x with TracingConfig PassThrough — no active tracing",
      "difficulty": "hard",
      "prompt_file": "prompts/missing-tracing-nodejs20.md",
      "baseline_file": "baselines/missing-tracing-nodejs20.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "missing-tracing-nodejs20", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DEPRECATED_RUNTIME"]
        }
      ]
    },
    {
      "id": "clean-function-python312-ok",
      "name": "python3.12 with scoped role, no URL, active tracing, DLQ — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/clean-function-python312-ok.md",
      "baseline_file": "baselines/clean-function-python312-ok.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "clean-function-python312-ok", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: DEPRECATED_RUNTIME", "VERDICT: OVERPERMISSIVE"]
        }
      ]
    },
    {
      "id": "nodejs16-public-and-deprecated",
      "name": "nodejs16.x (blocked Phase 2) with public Function URL — worst-finding aggregation",
      "difficulty": "hard",
      "prompt_file": "prompts/nodejs16-public-and-deprecated.md",
      "baseline_file": "baselines/nodejs16-public-and-deprecated.md",
      "expected_verdict": "DEPRECATED_RUNTIME",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["DEPRECATED_RUNTIME", "nodejs16-public-and-deprecated", "VERDICT", "REASON", "REMEDIATION", "nodejs16.x"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: OVERPERMISSIVE"]
        }
      ]
    }
  ]
}
