{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "globalaccelerator-deployer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Global Accelerator Deployer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "multi-region-alb-active-active",
      "name": "Standard multi-region ALB active-active accelerator with flow logs to S3 — all checklist dimensions pass",
      "difficulty": "easy",
      "prompt_file": "prompts/multi-region-alb-active-active.md",
      "baseline_file": "baselines/multi-region-alb-active-active.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "multi-region-alb-active-active", "VERDICT", "CHECKLIST", "DEPLOY_COMMANDS", "X-Forwarded-For", "active-active"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
      "id": "single-region-nlb-client-ip-preserve",
      "name": "Single-region NLB endpoint with PreserveClientIpEnabled true and CloudWatch flow logs",
      "difficulty": "medium",
      "prompt_file": "prompts/single-region-nlb-client-ip-preserve.md",
      "baseline_file": "baselines/single-region-nlb-client-ip-preserve.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "single-region-nlb-client-ip-preserve", "VERDICT", "PreserveClientIpEnabled", "NLB"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
      "id": "byoip-cidr-not-provisioned",
      "name": "BYOIP CIDR in PENDING_PROVISIONING state — hard blocker for Global Accelerator advertising",
      "difficulty": "medium",
      "prompt_file": "prompts/byoip-cidr-not-provisioned.md",
      "baseline_file": "baselines/byoip-cidr-not-provisioned.md",
      "expected_verdict": "PREREQUISITES_MISSING",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PREREQUISITES_MISSING", "byoip-cidr-not-provisioned", "VERDICT", "PROVISIONED"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: READY_TO_DEPLOY"]
        }
      ]
    },
    {
      "id": "mixed-endpoint-types-blocked",
      "name": "Mixing ALB and NLB endpoints in the same endpoint group — API rejects with ValidationError",
      "difficulty": "hard",
      "prompt_file": "prompts/mixed-endpoint-types-blocked.md",
      "baseline_file": "baselines/mixed-endpoint-types-blocked.md",
      "expected_verdict": "PREREQUISITES_MISSING",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PREREQUISITES_MISSING", "mixed-endpoint-types-blocked", "VERDICT", "homogeneous"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: READY_TO_DEPLOY"]
        }
      ]
    },
    {
      "id": "cross-account-endpoint-shared",
      "name": "Cross-account endpoint via ACTIVE RAM resource share — centralized edge platform",
      "difficulty": "hard",
      "prompt_file": "prompts/cross-account-endpoint-shared.md",
      "baseline_file": "baselines/cross-account-endpoint-shared.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "cross-account-endpoint-shared", "VERDICT", "RAM", "222222222222"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    }
  ]
}
