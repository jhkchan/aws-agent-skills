      "baseline_file": "baselines/vpc-cdk-l3-construct.md",
      "expected_verdict": "AUTOMATED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATED", "vpc-cdk-l3-construct", "VERDICT", "TEMPLATE", "Vpc", "SubnetType"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: MANUAL_STEP_REQUIRED"]
        }
      ]
    },
    {
      "id": "terraform-s3-backend-workspace",
