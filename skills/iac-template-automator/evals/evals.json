{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "iac-template-automator",
  "version": "1.0.0",
  "description": "Structured eval definitions for the IaC Template Automator. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "lambda-apigw-dynamodb-cfn",
      "name": "Generate CloudFormation SAM serverless template (Lambda + API Gateway + DynamoDB) — all gates pass",
      "difficulty": "easy",
      "prompt_file": "prompts/lambda-apigw-dynamodb-cfn.md",
      "baseline_file": "baselines/lambda-apigw-dynamodb-cfn.md",
      "expected_verdict": "AUTOMATED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATED", "lambda-apigw-dynamodb-cfn", "VERDICT", "TEMPLATE", "SECURITY", "AWS::Serverless::Function"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: MANUAL_STEP_REQUIRED"]
        }
      ]
    },
    {
      "id": "vpc-cdk-l3-construct",
