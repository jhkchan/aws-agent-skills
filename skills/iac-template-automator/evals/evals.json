      "difficulty": "medium",
      "prompt_file": "prompts/terraform-s3-backend-workspace.md",
      "baseline_file": "baselines/terraform-s3-backend-workspace.md",
      "expected_verdict": "AUTOMATED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATED", "terraform-s3-backend-workspace", "VERDICT", "TEMPLATE", "hashicorp/aws", "dynamodb_table"]
