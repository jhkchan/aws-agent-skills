{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "budgets-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Budgets Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "no-budgets-account",
      "name": "Account with zero budgets — total spend blind spot",
      "difficulty": "easy",
      "prompt_file": "prompts/no-budgets-account.md",
      "baseline_file": "baselines/no-budgets-account.md",
      "expected_verdict": "NO_BUDGET",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_BUDGET", "no-budgets-account", "VERDICT", "REASON", "REMEDIATION", "111111111111"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: NO_ALERT"]
        }
      ]
    },
    {
      "id": "budget-without-notifications",
      "name": "Budget exists but has zero notifications — decorative budget",
      "difficulty": "easy",
      "prompt_file": "prompts/budget-without-notifications.md",
      "baseline_file": "baselines/budget-without-notifications.md",
      "expected_verdict": "NO_ALERT",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ALERT", "budget-without-notifications", "VERDICT", "REASON", "REMEDIATION", "monthly-total"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_BUDGET"]
        }
      ]
    },
    {
      "id": "sns-policy-missing",
      "name": "SNS subscriber but topic policy lacks budgets.amazonaws.com publish — silent delivery failure",
      "difficulty": "hard",
      "prompt_file": "prompts/sns-policy-missing.md",
      "baseline_file": "baselines/sns-policy-missing.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "sns-policy-missing", "VERDICT", "REASON", "REMEDIATION", "budgets.amazonaws.com"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_BUDGET", "VERDICT: NO_ALERT"]
        }
      ]
    },
    {
      "id": "single-threshold-actual-only",
      "name": "Single 100% ACTUAL threshold with no FORECASTED — no reaction time, no predictive signal",
      "difficulty": "medium",
      "prompt_file": "prompts/single-threshold-actual-only.md",
      "baseline_file": "baselines/single-threshold-actual-only.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "single-threshold-actual-only", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_BUDGET", "VERDICT: NO_ALERT"]
        }
      ]
    },
    {
      "id": "well-configured-with-zero-spend",
      "name": "Multi-threshold ACTUAL+FORECASTED budget with valid SNS policy and zero-spend guardrail — clean",
      "difficulty": "easy",
      "prompt_file": "prompts/well-configured-with-zero-spend.md",
      "baseline_file": "baselines/well-configured-with-zero-spend.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "well-configured-with-zero-spend", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_BUDGET", "VERDICT: NO_ALERT", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "new-account-no-zero-spend",
      "name": "New sandbox account with correct alerting but no zero-spend guardrail — missing guardrail",
      "difficulty": "hard",
      "prompt_file": "prompts/new-account-no-zero-spend.md",
      "baseline_file": "baselines/new-account-no-zero-spend.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "new-account-no-zero-spend", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_BUDGET", "VERDICT: NO_ALERT"]
        }
      ]
    }
  ]
}
