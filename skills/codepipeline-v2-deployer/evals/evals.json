      "expected_verdict": "READY_TO_DEPLOY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "codecommit-codebuild-cloudformation", "VERDICT", "CHECKLIST", "DEPLOY_COMMANDS", "V2", "trigger"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
