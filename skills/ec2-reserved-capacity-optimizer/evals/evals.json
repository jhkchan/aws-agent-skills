{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "ec2-reserved-capacity-optimizer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the EC2 Reserved Capacity Optimizer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "low-ri-coverage-steady-state",
      "name": "Low RI coverage on steady-state 24/7 fleet — 40% coverage, should commit the baseline",
      "difficulty": "medium",
      "prompt_file": "prompts/low-ri-coverage-steady-state.md",
      "baseline_file": "baselines/low-ri-coverage-steady-state.md",
      "expected_verdict": "FURTHER_OPTIMIZATION_AVAILABLE",
      "expected_root_cause_category": "COVERAGE_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["FURTHER_OPTIMIZATION_AVAILABLE", "COVERAGE_GAP", "VERDICT", "ESTIMATED_SAVINGS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "OPTIMIZED"]
        }
      ]
    },
    {
      "id": "underutilized-ri-after-migration",
      "name": "Standard RIs at 55% utilization after fleet migrated to new family — should sell on Marketplace",
      "difficulty": "hard",
      "prompt_file": "prompts/underutilized-ri-after-migration.md",
      "baseline_file": "baselines/underutilized-ri-after-migration.md",
      "expected_verdict": "FURTHER_OPTIMIZATION_AVAILABLE",
      "expected_root_cause_category": "UTILIZATION_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["FURTHER_OPTIMIZATION_AVAILABLE", "UTILIZATION_GAP", "Marketplace", "VERDICT"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "OPTIMIZED"]
        }
      ]
    },
    {
      "id": "convertible-ri-exchange-opportunity",
      "name": "Convertible RIs at 60% utilization after right-sizing — should exchange to new instance type",
      "difficulty": "hard",
      "prompt_file": "prompts/convertible-ri-exchange-opportunity.md",
      "baseline_file": "baselines/convertible-ri-exchange-opportunity.md",
      "expected_verdict": "FURTHER_OPTIMIZATION_AVAILABLE",
      "expected_root_cause_category": "UTILIZATION_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["FURTHER_OPTIMIZATION_AVAILABLE", "UTILIZATION_GAP", "exchange", "VERDICT"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "OPTIMIZED"]
        }
      ]
    },
    {
      "id": "already-optimal-portfolio",
      "name": "Already-optimized portfolio — 95% coverage, 97% utilization, correct vehicle and term",
      "difficulty": "easy",
      "prompt_file": "prompts/already-optimal-portfolio.md",
      "baseline_file": "baselines/already-optimal-portfolio.md",
      "expected_verdict": "OPTIMIZED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPTIMIZED", "VERDICT"]
        },
        {
          "type": "must_not_contain",
          "values": ["FURTHER_OPTIMIZATION_AVAILABLE", "Error:", "I cannot"]
        }
      ]
    },
    {
      "id": "savings-plans-vs-ri-for-graviton-migration",
      "name": "Fleet planning Graviton migration — should recommend Compute SP over Standard RI for family flexibility",
      "difficulty": "medium",
      "prompt_file": "prompts/savings-plans-vs-ri-for-graviton-migration.md",
      "baseline_file": "baselines/savings-plans-vs-ri-for-graviton-migration.md",
      "expected_verdict": "FURTHER_OPTIMIZATION_AVAILABLE",
      "expected_root_cause_category": "VEHICLE_EVAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["FURTHER_OPTIMIZATION_AVAILABLE", "Compute SP", "VERDICT", "ESTIMATED_SAVINGS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "OPTIMIZED"]
        }
      ]
    }
  ]
}
