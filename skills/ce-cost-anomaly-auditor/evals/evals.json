{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "ce-cost-anomaly-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the CE Cost Anomaly Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "no-cad-monitors-at-all",
      "name": "Zero CAD monitors \u2014 total cost-spike blind spot",
      "difficulty": "easy",
      "prompt_file": "prompts/no-cad-monitors-at-all.md",
      "baseline_file": "baselines/no-cad-monitors-at-all.md",
      "expected_verdict": "NO_ANOMALY_SUB",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": [
            "NO_ANOMALY_SUB",
            "VERDICT",
            "REASON",
            "REMEDIATION",
            "zero"
          ]
        },
        {
          "type": "must_not_contain",
          "values": [
            "Error:",
            "I cannot",
            "I'm unable",
            "VERDICT: OK",
            "VERDICT: CONFIG_GAP",
            "VERDICT: LOW_RI_COVERAGE"
          ]
        }
      ]
    },
    {
      "id": "monitors-no-subscriptions",
      "name": "CAD monitors with zero subscriptions \u2014 detection without delivery",
      "difficulty": "medium",
      "prompt_file": "prompts/monitors-no-subscriptions.md",
      "baseline_file": "baselines/monitors-no-subscriptions.md",
      "expected_verdict": "NO_ANOMALY_SUB",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": [
            "NO_ANOMALY_SUB",
            "VERDICT",
            "REASON",
            "REMEDIATION",
            "subscription"
          ]
        },
        {
          "type": "must_not_contain",
          "values": [
            "Error:",
            "I cannot",
            "I'm unable",
            "VERDICT: OK",
            "VERDICT: CONFIG_GAP"
          ]
        }
      ]
    },
    {
      "id": "low-ri-coverage-steady-state",
      "name": "Low RI/SP coverage on steady-state compute \u2014 on-demand leak",
      "difficulty": "medium",
      "prompt_file": "prompts/low-ri-coverage-steady-state.md",
      "baseline_file": "baselines/low-ri-coverage-steady-state.md",
      "expected_verdict": "LOW_RI_COVERAGE",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": [
            "LOW_RI_COVERAGE",
            "VERDICT",
            "REASON",
            "REMEDIATION",
            "22%"
          ]
        },
        {
          "type": "must_not_contain",
          "values": [
            "Error:",
            "I cannot",
            "I'm unable",
            "VERDICT: OK",
            "VERDICT: CONFIG_GAP",
            "VERDICT: NO_ANOMALY_SUB"
          ]
        }
      ]
    },
    {
      "id": "immediate-monitor-weekly-subscription",
      "name": "IMMEDIATE monitor with WEEKLY subscription \u2014 notification latency >> detection",
      "difficulty": "hard",
      "prompt_file": "prompts/immediate-monitor-weekly-subscription.md",
      "baseline_file": "baselines/immediate-monitor-weekly-subscription.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
