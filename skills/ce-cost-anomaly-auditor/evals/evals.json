            "CONFIG_GAP",
            "VERDICT",
            "REASON",
            "REMEDIATION",
            "WEEKLY"
          ]
        },
        {
          "type": "must_not_contain",
          "values": [
            "Error:",
            "I cannot",
            "I'm unable",
            "VERDICT: OK",
            "VERDICT: NO_ANOMALY_SUB"
          ]
        }
      ]
    },
    {
      "id": "daily-only-no-cur",
      "name": "DAILY-only monitors with no CUR resource IDs \u2014 sub-day spikes and idle detection blind",
      "difficulty": "hard",
      "prompt_file": "prompts/daily-only-no-cur.md",
      "baseline_file": "baselines/daily-only-no-cur.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": [
            "CONFIG_GAP",
            "VERDICT",
            "REASON",
            "REMEDIATION",
            "DAILY"
          ]
        },
        {
          "type": "must_not_contain",
          "values": [
            "Error:",
            "I cannot",
            "I'm unable",
            "VERDICT: OK",
            "VERDICT: NO_ANOMALY_SUB"
          ]
        }
      ]
    },
    {
      "id": "well-configured-production",
      "name": "Well-configured production \u2014 IMMEDIATE monitor, calibrated threshold, coverage OK",
      "difficulty": "easy",
      "prompt_file": "prompts/well-configured-production.md",
      "baseline_file": "baselines/well-configured-production.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": [
            "OK",
            "VERDICT",
            "REASON",
            "REMEDIATION"
          ]
        },
        {
          "type": "must_not_contain",
          "values": [
            "Error:",
            "I cannot",
            "I'm unable",
            "VERDICT: NO_ANOMALY_SUB",
            "VERDICT: LOW_RI_COVERAGE",
