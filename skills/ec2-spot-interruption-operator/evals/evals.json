      "baseline_file": "baselines/handle-interruption-graceful-shutdown-completed.md",
      "expected_verdict": "OPERATION_COMPLETED",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPERATION_COMPLETED", "i-0abc123def456", "deregister", "checkpoint", "VERDICT", "PRE_CHECKS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: REVIEW_REQUIRED", "VERDICT: ERROR"]
        }
      ]
    },
    {
      "id": "tune-strategy-lowest-price-review-required",
