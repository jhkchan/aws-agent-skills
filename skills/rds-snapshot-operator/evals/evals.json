      "expected_verdict": "OPERATION_COMPLETED",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPERATION_COMPLETED", "prod-orders-db", "create-db-snapshot", "VERDICT", "PRE_CHECKS", "prod-orders-db-pre-upgrade-20260805", "CONFIRM"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "REVIEW_REQUIRED"]
        }
      ]
    },
    {
      "id": "copy-snapshot-cross-region-dr-completed",
