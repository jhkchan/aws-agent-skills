{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "accessanalyzer-finding-triage",
  "version": "1.0.0",
  "description": "Structured eval definitions for the IAM Access Analyzer Finding Triage skill. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "kms-external-public",
      "name": "KMS key with public principal and no condition — CRITICAL external access",
      "difficulty": "easy",
      "prompt_file": "prompts/kms-external-public.md",
      "baseline_file": "baselines/kms-external-public.md",
      "expected_verdict": "EXTERNAL_ACCESS",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["EXTERNAL_ACCESS", "kms-external-public", "VERDICT", "REASON", "REMEDIATION", "CRITICAL"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: SAFE", "VERDICT: EXPECTED"]
        }
      ]
    },
    {
      "id": "s3-source-arn-bounded",
      "name": "S3 bucket with external principal bounded by aws:SourceArn — SAFE",
      "difficulty": "hard",
      "prompt_file": "prompts/s3-source-arn-bounded.md",
      "baseline_file": "baselines/s3-source-arn-bounded.md",
      "expected_verdict": "SAFE",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["SAFE", "s3-source-arn-bounded", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: EXTERNAL_ACCESS"]
        }
      ]
    },
    {
