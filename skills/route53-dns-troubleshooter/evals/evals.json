{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "route53-dns-troubleshooter",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Route 53 DNS Troubleshooter. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "ns-delegation-mismatch",
      "name": "NXDOMAIN — registrar NS points at old provider, not Route 53 hosted zone NS",
      "difficulty": "hard",
      "prompt_file": "prompts/ns-delegation-mismatch.md",
      "baseline_file": "baselines/ns-delegation-mismatch.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_layer": "NS_DELEGATION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "ns-delegation-mismatch", "NS_DELEGATION", "VERDICT", "REASON", "EVIDENCE", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "LAYER: DNS_CACHE_TTL"]
        }
      ]
    },
    {
      "id": "dnssec-ds-record-mismatch",
      "name": "SERVFAIL from validating resolvers after KSK rotation — DS record at parent has old key tag",
      "difficulty": "hard",
      "prompt_file": "prompts/dnssec-ds-record-mismatch.md",
      "baseline_file": "baselines/dnssec-ds-record-mismatch.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_layer": "DNSSEC_DS",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "dnssec-ds-record-mismatch", "DNSSEC_DS", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "LAYER: DNSSEC_KSK"]
        }
      ]
    },
    {
      "id": "private-hosted-zone-vpc-association",
      "name": "Private hosted zone not resolving from VPC — VPCs association list is empty",
      "difficulty": "medium",
      "prompt_file": "prompts/private-hosted-zone-vpc-association.md",
      "baseline_file": "baselines/private-hosted-zone-vpc-association.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_layer": "PHZ_VPC_ASSOCIATION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "private-hosted-zone-vpc-association", "PHZ_VPC_ASSOCIATION", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "LAYER: SPLIT_HORIZON"]
        }
      ]
    },
    {
      "id": "health-check-failing-failover",
      "name": "Failover PRIMARY never served — health check monitors the record name (circular dependency) instead of ALB endpoint",
      "difficulty": "hard",
      "prompt_file": "prompts/health-check-failing-failover.md",
      "baseline_file": "baselines/health-check-failing-failover.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_layer": "HEALTH_CHECK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "health-check-failing-failover", "HEALTH_CHECK", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "LAYER: ROUTING_FAILOVER"]
        }
      ]
    },
    {
      "id": "alias-cname-conflict",
      "name": "ALIAS record creation fails with ConflictingDomainExists — existing CNAME for the same name",
      "difficulty": "medium",
      "prompt_file": "prompts/alias-cname-conflict.md",
      "baseline_file": "baselines/alias-cname-conflict.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_layer": "ALIAS_CNAME_CONFLICT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "alias-cname-conflict", "ALIAS_CNAME_CONFLICT", "VERDICT", "REASON", "EVIDENCE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "LAYER: NS_DELEGATION"]
        }
      ]
    }
  ]
}
