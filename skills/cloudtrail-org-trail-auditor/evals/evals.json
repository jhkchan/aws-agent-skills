{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "cloudtrail-org-trail-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the CloudTrail Organization Trail Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "org-trail-ok",
      "name": "Fully configured org trail — all dimensions pass",
      "difficulty": "easy",
      "prompt_file": "prompts/org-trail-ok.md",
      "baseline_file": "baselines/org-trail-ok.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "org-trail-ok", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_ORG_TRAIL", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "no-org-trail",
      "name": "Single-account trail not covering the org — NO_ORG_TRAIL",
      "difficulty": "easy",
      "prompt_file": "prompts/no-org-trail.md",
      "baseline_file": "baselines/no-org-trail.md",
      "expected_verdict": "NO_ORG_TRAIL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ORG_TRAIL", "no-org-trail", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "org-trail-no-encryption",
      "name": "Org trail without KMS encryption — NO_ENCRYPTION",
      "difficulty": "medium",
      "prompt_file": "prompts/org-trail-no-encryption.md",
      "baseline_file": "baselines/org-trail-no-encryption.md",
      "expected_verdict": "NO_ENCRYPTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ENCRYPTION", "org-trail-no-encryption", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "org-trail-no-validation",
      "name": "Org trail with log file validation disabled — NO_VALIDATION",
      "difficulty": "medium",
      "prompt_file": "prompts/org-trail-no-validation.md",
      "baseline_file": "baselines/org-trail-no-validation.md",
      "expected_verdict": "NO_VALIDATION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_VALIDATION", "org-trail-no-validation", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "org-trail-no-insights",
      "name": "Org trail with no CloudTrail Insights — NO_INSIGHTS",
      "difficulty": "hard",
      "prompt_file": "prompts/org-trail-no-insights.md",
      "baseline_file": "baselines/org-trail-no-insights.md",
      "expected_verdict": "NO_INSIGHTS",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_INSIGHTS", "org-trail-no-insights", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "org-trail-config-gap",
      "name": "Org trail with multiple secondary gaps — CONFIG_GAP",
      "difficulty": "hard",
      "prompt_file": "prompts/org-trail-config-gap.md",
      "baseline_file": "baselines/org-trail-config-gap.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "org-trail-config-gap", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK"]
        }
      ]
    }
  ]
}
