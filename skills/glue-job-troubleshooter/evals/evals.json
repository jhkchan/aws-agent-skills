          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "VERDICT: ESCALATE"]
        }
      ]
    },
    {
      "id": "catalog-table-not-found",
      "name": "EntityNotFoundException fires because cross-account job role lacks glue:GetTable, not because table is missing",
      "difficulty": "medium",
      "prompt_file": "prompts/catalog-table-not-found.md",
      "baseline_file": "baselines/catalog-table-not-found.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "catalog-table-not-found", "CATALOG_MISSING", "EVIDENCE", "REMEDIATION"]
