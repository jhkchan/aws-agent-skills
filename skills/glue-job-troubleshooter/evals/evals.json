        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "VERDICT: ESCALATE"]
        }
      ]
    },
    {
      "id": "spark-oom-stage-skew",
      "name": "Spark executor OOM in stage 7 join — 316x skew on hot key customer_id=ACME-001",
      "difficulty": "hard",
      "prompt_file": "prompts/spark-oom-stage-skew.md",
      "baseline_file": "baselines/spark-oom-stage-skew.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "spark-oom-stage-skew", "SPARK_OOM", "skew", "EVIDENCE", "REMEDIATION"]
