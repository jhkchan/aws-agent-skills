{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "securityhub-control-compliance-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Security Hub Control-Compliance Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "s3-bpa-failed",
      "name": "Active FAILED finding for S3.2 — bucket-level BPA not set",
      "difficulty": "easy",
      "prompt_file": "prompts/s3-bpa-failed.md",
      "baseline_file": "baselines/s3-bpa-failed.md",
      "expected_verdict": "FAILED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["FAILED", "S3.2", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PASSED", "VERDICT: NOT_APPLICABLE"]
        }
      ]
    },
    {
      "id": "iam-password-policy-passed",
      "name": "Active PASSED finding for IAM.7 — password policy compliant",
      "difficulty": "easy",
      "prompt_file": "prompts/iam-password-policy-passed.md",
      "baseline_file": "baselines/iam-password-policy-passed.md",
      "expected_verdict": "PASSED",
      "expected_risk": "—",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PASSED", "IAM.7", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: FAILED", "VERDICT: NOT_APPLICABLE"]
        }
      ]
    },
    {
      "id": "not-available-no-resources",
      "name": "NOT_AVAILABLE with NO_RESOURCES — control does not apply, NOT_APPLICABLE",
      "difficulty": "hard",
      "prompt_file": "prompts/not-available-no-resources.md",
      "baseline_file": "baselines/not-available-no-resources.md",
      "expected_verdict": "NOT_APPLICABLE",
      "expected_risk": "—",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NOT_APPLICABLE", "Redshift.1", "VERDICT", "REASON"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: FAILED", "VERDICT: PASSED"]
        }
      ]
    },
    {
      "id": "not-available-service-disabled",
      "name": "NOT_AVAILABLE with SUPPORTED_SERVICE_NOT_ENABLED — Config gap is a WARNING",
      "difficulty": "hard",
      "prompt_file": "prompts/not-available-service-disabled.md",
      "baseline_file": "baselines/not-available-service-disabled.md",
      "expected_verdict": "WARNING",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["WARNING", "Config.1", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PASSED", "VERDICT: FAILED"]
        }
      ]
    },
    {
      "id": "suppressed-failed",
      "name": "SUPPRESSED + FAILED finding — governance concern, WARNING not PASSED",
      "difficulty": "hard",
      "prompt_file": "prompts/suppressed-failed.md",
      "baseline_file": "baselines/suppressed-failed.md",
      "expected_verdict": "WARNING",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["WARNING", "EC2.15", "VERDICT", "REASON"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PASSED", "VERDICT: NOT_APPLICABLE"]
        }
      ]
    },
    {
      "id": "archived-finding",
      "name": "ARCHIVED finding — stale, resource deleted, NOT_APPLICABLE not FAILED",
      "difficulty": "medium",
      "prompt_file": "prompts/archived-finding.md",
      "baseline_file": "baselines/archived-finding.md",
      "expected_verdict": "NOT_APPLICABLE",
      "expected_risk": "—",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NOT_APPLICABLE", "CloudTrail.1", "VERDICT", "REASON"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: FAILED", "VERDICT: PASSED"]
        }
      ]
    }
  ]
}
