{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "backup-plan-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Backup Plan Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "coverage-gap-empty-selection",
      "name": "Empty resource selection — plan backs up nothing",
      "difficulty": "medium",
      "prompt_file": "prompts/coverage-gap-empty-selection.md",
      "baseline_file": "baselines/coverage-gap-empty-selection.md",
      "expected_verdict": "COVERAGE_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["COVERAGE_GAP", "daily-ec2-backup", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: VAULT_RISK"]
        }
      ]
    },
    {
      "id": "vault-risk-no-lock-aws-managed-key",
      "name": "Vault with no lock and AWS-managed key — ransomware-vulnerable",
      "difficulty": "medium",
      "prompt_file": "prompts/vault-risk-no-lock-aws-managed-key.md",
      "baseline_file": "baselines/vault-risk-no-lock-aws-managed-key.md",
      "expected_verdict": "VAULT_RISK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VAULT_RISK", "prod-database-backup", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: COVERAGE_GAP"]
        }
      ]
    },
    {
      "id": "noncompliant-weekly-short-retention",
      "name": "Weekly schedule with 7-day retention — below compliance baseline",
      "difficulty": "hard",
      "prompt_file": "prompts/noncompliant-weekly-short-retention.md",
      "baseline_file": "baselines/noncompliant-weekly-short-retention.md",
      "expected_verdict": "NONCOMPLIANT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NONCOMPLIANT", "weekly-archive-plan", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "config-gap-impossible-lifecycle",
      "name": "Cold storage transition after deletion — impossible lifecycle",
      "difficulty": "hard",
      "prompt_file": "prompts/config-gap-impossible-lifecycle.md",
      "baseline_file": "baselines/config-gap-impossible-lifecycle.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "cold-storage-backup", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: COVERAGE_GAP"]
        }
      ]
    },
    {
      "id": "ok-well-configured",
      "name": "Daily schedule, locked vault, CMK, cross-region copy — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/ok-well-configured.md",
      "baseline_file": "baselines/ok-well-configured.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "prod-compliant-backup", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: COVERAGE_GAP", "VERDICT: VAULT_RISK"]
        }
      ]
    },
    {
      "id": "vault-risk-governance-mode",
      "name": "Vault lock in governance mode — root can still unlock",
      "difficulty": "hard",
      "prompt_file": "prompts/vault-risk-governance-mode.md",
      "baseline_file": "baselines/vault-risk-governance-mode.md",
      "expected_verdict": "VAULT_RISK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VAULT_RISK", "staging-backup-plan", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NONCOMPLIANT"]
        }
      ]
    }
  ]
}
