{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "ecs-task-troubleshooter",
  "version": "1.0.0",
  "description": "Structured eval definitions for the ECS Task Troubleshooter. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "fargate-essential-container-secret-injection",
      "name": "Fargate task exits in 2s — execution role lacks secretsmanager:GetSecretValue",
      "difficulty": "hard",
      "prompt_file": "prompts/fargate-essential-container-secret-injection.md",
      "baseline_file": "baselines/fargate-essential-container-secret-injection.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_root_cause": "CONFIG_EXECUTION_ROLE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "CONFIG_EXECUTION_ROLE", "secretsmanager:GetSecretValue", "execution role", "VERDICT", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: INSUFFICIENT_DATA", "ROOT_CAUSE_FOUND", "privileged"]
        }
      ]
    },
    {
      "id": "fargate-oom-jvm-heap",
      "name": "Java container OOMKilled — -Xmx exceeds container memory hard limit",
      "difficulty": "medium",
      "prompt_file": "prompts/fargate-oom-jvm-heap.md",
      "baseline_file": "baselines/fargate-oom-jvm-heap.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_root_cause": "OOM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "OOM", "memory", "Xmx", "VERDICT", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: INSUFFICIENT_DATA", "ROOT_CAUSE_FOUND", "privileged"]
        }
      ]
    },
    {
      "id": "alb-health-check-path-mismatch",
      "name": "ALB target group unhealthy — health check path /healthz does not match app /api/health",
      "difficulty": "medium",
      "prompt_file": "prompts/alb-health-check-path-mismatch.md",
      "baseline_file": "baselines/alb-health-check-path-mismatch.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_root_cause": "HEALTH_CHECK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "HEALTH_CHECK", "/api/health", "VERDICT", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: INSUFFICIENT_DATA", "ROOT_CAUSE_FOUND"]
        }
      ]
    },
    {
      "id": "ecr-image-pull-execution-role",
      "name": "Fargate CannotPullContainerError — execution role lacks ecr:BatchGetImage",
      "difficulty": "medium",
      "prompt_file": "prompts/ecr-image-pull-execution-role.md",
      "baseline_file": "baselines/ecr-image-pull-execution-role.md",
      "expected_verdict": "ROOT_CAUSE_IDENTIFIED",
      "expected_root_cause": "IMAGE_PULL_AUTH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "IMAGE_PULL_AUTH", "ecr:BatchGetImage", "execution role", "VERDICT", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: INSUFFICIENT_DATA", "ROOT_CAUSE_FOUND"]
        }
      ]
    },
    {
      "id": "insufficient-context-need-task-arn",
      "name": "Vague report of failing ECS tasks — request task ARN + describe-tasks output",
      "difficulty": "easy",
      "prompt_file": "prompts/insufficient-context-need-task-arn.md",
      "baseline_file": "baselines/insufficient-context-need-task-arn.md",
      "expected_verdict": "INSUFFICIENT_DATA",
      "expected_root_cause": "UNKNOWN",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["INSUFFICIENT_DATA", "VERDICT", "describe-tasks"]
        },
        {
          "type": "must_not_contain",
          "values": ["ROOT_CAUSE_IDENTIFIED", "ROOT_CAUSE_FOUND", "Error:", "I cannot"]
        }
      ]
    }
  ]
}
