{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "kms-key-policy-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the KMS Key Policy Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "cross-account-decrypt-no-condition",
      "name": "Cross-account kms:Decrypt with no condition — full data exposure",
      "difficulty": "medium",
      "prompt_file": "prompts/cross-account-decrypt-no-condition.md",
      "baseline_file": "baselines/cross-account-decrypt-no-condition.md",
      "expected_verdict": "CRITICAL",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CRITICAL", "cross-account-decrypt-no-condition", "VERDICT", "REASON", "REMEDIATION", "222222222222"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: HIGH"]
        }
      ]
    },
    {
      "id": "wildcard-kms-all-no-condition",
      "name": "Wildcard kms:* to Principal * — any account has full key control",
      "difficulty": "easy",
      "prompt_file": "prompts/wildcard-kms-all-no-condition.md",
      "baseline_file": "baselines/wildcard-kms-all-no-condition.md",
      "expected_verdict": "CRITICAL",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CRITICAL", "wildcard-kms-all-no-condition", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: HIGH"]
        }
      ]
    },
    {
      "id": "same-account-via-service-ok",
      "name": "Same-account named actions with kms:ViaService and rotation enabled — clean",
      "difficulty": "easy",
      "prompt_file": "prompts/same-account-via-service-ok.md",
      "baseline_file": "baselines/same-account-via-service-ok.md",
      "expected_verdict": "OK",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "same-account-via-service-ok", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: CRITICAL", "VERDICT: HIGH"]
        }
      ]
    },
    {
      "id": "cross-account-decrypt-source-account-medium",
      "name": "Cross-account kms:Decrypt restricted by aws:SourceAccount — fragile but scoped",
      "difficulty": "hard",
      "prompt_file": "prompts/cross-account-decrypt-source-account-medium.md",
      "baseline_file": "baselines/cross-account-decrypt-source-account-medium.md",
      "expected_verdict": "MEDIUM",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["MEDIUM", "cross-account-decrypt-source-account-medium", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: CRITICAL", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "rotation-disabled-same-account-high",
      "name": "Same-account clean policy but rotation disabled — stale key material",
      "difficulty": "medium",
      "prompt_file": "prompts/rotation-disabled-same-account-high.md",
      "baseline_file": "baselines/rotation-disabled-same-account-high.md",
      "expected_verdict": "HIGH",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["HIGH", "rotation-disabled-same-account-high", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: CRITICAL", "VERDICT: OK"]
        }
      ]
    },
    {
      "id": "pending-deletion-7-days",
      "name": "Key in PendingDeletion with 7-day window — imminent irrecoverable data loss",
      "difficulty": "hard",
      "prompt_file": "prompts/pending-deletion-7-days.md",
      "baseline_file": "baselines/pending-deletion-7-days.md",
      "expected_verdict": "CRITICAL",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CRITICAL", "pending-deletion-7-days", "VERDICT", "REASON", "REMEDIATION", "PendingDeletion"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: HIGH"]
        }
      ]
    }
  ]
}
