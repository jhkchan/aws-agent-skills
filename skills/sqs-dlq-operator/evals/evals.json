{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "sqs-dlq-operator",
  "version": "1.0.0",
  "description": "Structured eval definitions for the SQS DLQ Operator. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "create-standard-dlq-wire-redrive-ready",
      "name": "Create Standard DLQ and wire redrive policy — all pre-checks pass (READY)",
      "difficulty": "easy",
      "prompt_file": "prompts/create-standard-dlq-wire-redrive-ready.md",
      "baseline_file": "baselines/create-standard-dlq-wire-redrive-ready.md",
      "expected_verdict": "READY",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY", "prod-orders-dlq", "create-queue", "VERDICT", "CONFIRM", "RedrivePolicy"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: BLOCKED", "VERDICT: COMPLETED"]
        }
      ]
    },
    {
      "id": "fifo-type-mismatch-blocked",
      "name": "Create DLQ for FIFO source with Standard DLQ name — type mismatch (BLOCKED)",
      "difficulty": "hard",
      "prompt_file": "prompts/fifo-type-mismatch-blocked.md",
      "baseline_file": "baselines/fifo-type-mismatch-blocked.md",
      "expected_verdict": "BLOCKED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["BLOCKED", "FIFO", ".fifo", "VERDICT", "type"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: READY", "VERDICT: COMPLETED"]
        }
      ]
    },
    {
      "id": "analyze-dlq-visibility-timeout-race-blocked",
      "name": "Analyze DLQ filling with valid messages — visibility-timeout race + missing partial-batch (BLOCKED)",
      "difficulty": "hard",
      "prompt_file": "prompts/analyze-dlq-visibility-timeout-race-blocked.md",
      "baseline_file": "baselines/analyze-dlq-visibility-timeout-race-blocked.md",
      "expected_verdict": "BLOCKED",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["BLOCKED", "ReportBatchItemFailures", "VisibilityTimeout", "VERDICT"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: READY", "VERDICT: COMPLETED"]
        }
      ]
    },
    {
      "id": "replay-startmessagemovetask-completed",
      "name": "Replay DLQ messages via StartMessageMoveTask after root-cause fix — post-verification passed (COMPLETED)",
      "difficulty": "easy",
      "prompt_file": "prompts/replay-startmessagemovetask-completed.md",
      "baseline_file": "baselines/replay-startmessagemovetask-completed.md",
      "expected_verdict": "COMPLETED",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["COMPLETED", "prod-orders", "StartMessageMoveTask", "VERDICT", "POST_VERIFY"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: READY", "VERDICT: BLOCKED"]
        }
      ]
    },
    {
      "id": "replay-no-active-consumer-blocked",
      "name": "Replay blocked — source queue has no active consumer (Lambda mapping disabled) (BLOCKED)",
      "difficulty": "medium",
      "prompt_file": "prompts/replay-no-active-consumer-blocked.md",
      "baseline_file": "baselines/replay-no-active-consumer-blocked.md",
      "expected_verdict": "BLOCKED",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["BLOCKED", "consumer", "VERDICT"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: READY", "VERDICT: COMPLETED"]
        }
      ]
    }
  ]
}
