      "prompt_file": "prompts/s3-archive-pipeline.md",
      "baseline_file": "baselines/s3-archive-pipeline.md",
      "expected_verdict": "AUTOMATION_DEPLOYED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
