      "prompt_file": "prompts/tag-based-retention-prod.md",
      "baseline_file": "baselines/tag-based-retention-prod.md",
      "expected_verdict": "AUTOMATION_DEPLOYED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATION_DEPLOYED", "tag-based-retention-prod", "put-retention-policy", "VERDICT", "TRIGGER", "TEMPLATE"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: REVIEW_REQUIRED"]
        }
      ]
    },
    {
      "id": "eventbridge-auto-retention",
