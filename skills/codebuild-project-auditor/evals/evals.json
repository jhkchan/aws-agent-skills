{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "codebuild-project-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the CodeBuild Project Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "privileged-dind-no-docker",
      "name": "privilegedMode=true on a Maven build with no Docker commands — host-equivalent privilege for no Docker reason",
      "difficulty": "medium",
      "prompt_file": "prompts/privileged-dind-no-docker.md",
      "baseline_file": "baselines/privileged-dind-no-docker.md",
      "expected_verdict": "PRIVILEGED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PRIVILEGED", "privileged-dind-no-docker", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: SECRET_LEAK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "secret-env-plaintext-leak",
      "name": "DB_PASSWORD and GITHUB_TOKEN in environmentVariables type=PLAINTEXT — credentials committed to project config",
      "difficulty": "medium",
      "prompt_file": "prompts/secret-env-plaintext-leak.md",
      "baseline_file": "baselines/secret-env-plaintext-leak.md",
      "expected_verdict": "SECRET_LEAK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["SECRET_LEAK", "secret-env-plaintext-leak", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PRIVILEGED", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "s3-logs-no-kms-encryption",
      "name": "s3LogsConfig.encryptionDisabled=true and artifacts.encryptionDisabled=true — build outputs without customer-managed SSE-KMS",
      "difficulty": "medium",
      "prompt_file": "prompts/s3-logs-no-kms-encryption.md",
      "baseline_file": "baselines/s3-logs-no-kms-encryption.md",
      "expected_verdict": "NO_ENCRYPTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ENCRYPTION", "s3-logs-no-kms-encryption", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PRIVILEGED", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "overpermissive-build-role",
      "name": "Service role with Action=* on Resource=* — admin wildcard on the role assumed during every build",
      "difficulty": "hard",
      "prompt_file": "prompts/overpermissive-build-role.md",
      "baseline_file": "baselines/overpermissive-build-role.md",
      "expected_verdict": "OVERPERMISSIVE_ROLE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OVERPERMISSIVE_ROLE", "overpermissive-build-role", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PRIVILEGED", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "badge-public-status-leak",
      "name": "badgeEnabled=true with otherwise clean posture — public build-status URL leaks project existence",
      "difficulty": "easy",
      "prompt_file": "prompts/badge-public-status-leak.md",
      "baseline_file": "baselines/badge-public-status-leak.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "badge-public-status-leak", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: PRIVILEGED", "VERDICT: SECRET_LEAK"]
        }
      ]
    },
    {
      "id": "clean-hardened-codebuild",
      "name": "Hardened project: privilegedMode false, secrets via Secrets Manager, SSE-KMS logs and artifacts, scoped named-action service role, scoped trust policy, private VPC subnets, badge disabled",
      "difficulty": "easy",
      "prompt_file": "prompts/clean-hardened-codebuild.md",
      "baseline_file": "baselines/clean-hardened-codebuild.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "clean-hardened-codebuild", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: PRIVILEGED", "VERDICT: SECRET_LEAK", "VERDICT: NO_ENCRYPTION", "VERDICT: OVERPERMISSIVE_ROLE", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
