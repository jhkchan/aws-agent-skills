{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "incident-response-automator",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Incident Response Automator. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "guardduty-ec2-quarantine",
      "name": "Automated EC2 quarantine on GuardDuty severity >= 7 via AWS-IsolateEC2Instance — all safety gates pass",
      "difficulty": "easy",
      "prompt_file": "prompts/guardduty-ec2-quarantine.md",
      "baseline_file": "baselines/guardduty-ec2-quarantine.md",
      "expected_verdict": "AUTOMATED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATED", "guardduty-ec2-quarantine", "VERDICT", "WORKFLOW", "AWS-IsolateEC2Instance"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: MANUAL_STEP_REQUIRED"]
        }
      ]
    },
    {
      "id": "iam-key-revocation-workflow",
