      "difficulty": "hard",
      "prompt_file": "prompts/deploy-org-rule-prereqs-missing.md",
      "baseline_file": "baselines/deploy-org-rule-prereqs-missing.md",
      "expected_verdict": "PREREQUISITES_MISSING",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["PREREQUISITES_MISSING", "management account", "222222222222", "VERDICT", "organization"]
