      "expected_verdict": "READY_TO_DEPLOY",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "ec2-required-tags", "put-config-rule", "VERDICT", "CUSTOM_LAMBDA", "config.amazonaws.com"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
      "id": "deploy-conformance-pack-ready",
      "name": "Deploy CIS AWS Foundations conformance pack with 5 managed rules — all pre-checks pass (READY_TO_DEPLOY)",
      "difficulty": "medium",
      "prompt_file": "prompts/deploy-conformance-pack-ready.md",
      "baseline_file": "baselines/deploy-conformance-pack-ready.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "expected_risk": "MODERATE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
