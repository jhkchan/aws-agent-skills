{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "config-rule-deployer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the AWS Config Rule Deployer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "deploy-managed-s3-rule-ready",
      "name": "Deploy managed Config rule s3-bucket-public-read-prohibited — all pre-checks pass (READY_TO_DEPLOY)",
      "difficulty": "easy",
      "prompt_file": "prompts/deploy-managed-s3-rule-ready.md",
      "baseline_file": "baselines/deploy-managed-s3-rule-ready.md",
      "expected_verdict": "READY_TO_DEPLOY",
      "expected_risk": "LOW",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["READY_TO_DEPLOY", "s3-bucket-public-read-prohibited", "put-config-rule", "VERDICT", "CONFIRM", "S3_BUCKET_PUBLIC_READ_PROHIBITED"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: PREREQUISITES_MISSING"]
        }
      ]
    },
    {
      "id": "deploy-custom-lambda-rule-ready",
