{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "fargate-cost-optimizer",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Fargate Cost Optimizer. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "rightsizing-overprovisioned-cpu-memory",
      "name": "Over-provisioned Fargate task — 2 vCPU / 4 GB at 18% avg CPU, should downsize to 1 vCPU / 2 GB",
      "difficulty": "medium",
      "prompt_file": "prompts/rightsizing-overprovisioned-cpu-memory.md",
      "baseline_file": "baselines/rightsizing-overprovisioned-cpu-memory.md",
      "expected_verdict": "OPPORTUNITY_FOUND",
      "expected_root_cause_category": "RIGHT_SIZE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OPPORTUNITY_FOUND", "RIGHT_SIZE", "VERDICT", "ESTIMATED_SAVINGS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "ALREADY_OPTIMAL"]
        }
      ]
    },
    {
      "id": "fargate-spot-fault-tolerant",
      "name": "Stateless SQS worker on 100% On-Demand Fargate — should use Fargate Spot capacity provider",
