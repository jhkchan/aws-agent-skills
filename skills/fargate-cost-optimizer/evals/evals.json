          "type": "must_contain",
          "values": ["OPPORTUNITY_FOUND", "Spot", "VERDICT", "ESTIMATED_SAVINGS"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "ALREADY_OPTIMAL"]
        }
      ]
    },
    {
