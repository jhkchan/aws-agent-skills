      "difficulty": "hard",
      "prompt_file": "prompts/graviton-arm64-migration.md",
      "baseline_file": "baselines/graviton-arm64-migration.md",
      "expected_verdict": "OPPORTUNITY_FOUND",
      "expected_root_cause_category": "ARM64",
      "files": [],
