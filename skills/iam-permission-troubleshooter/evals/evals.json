{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "iam-permission-troubleshooter",
  "version": "1.0.0",
  "description": "Structured eval definitions for the IAM Permission Troubleshooter. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "kms-cross-account-decrypt",
      "name": "Cross-account Lambda cannot read KMS-encrypted S3 object — KMS key policy missing caller",
      "difficulty": "hard",
      "prompt_file": "prompts/kms-cross-account-decrypt.md",
      "baseline_file": "baselines/kms-cross-account-decrypt.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "expected_root_cause_layer": "KMS key policy (resource-based)",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "VERDICT", "ROOT_CAUSE", "REMEDIATION", "cross-account"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NEED_MORE_INFO", "VERDICT: ESCALATE"]
        }
      ]
    },
    {
      "id": "assume-role-trust-policy",
      "name": "sts:AssumeRole fails — target role trust policy does not list the caller principal",
      "difficulty": "medium",
      "prompt_file": "prompts/assume-role-trust-policy.md",
      "baseline_file": "baselines/assume-role-trust-policy.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "expected_root_cause_layer": "Trust policy (resource-based on target role)",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "trust policy", "VERDICT", "Principal", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: NEED_MORE_INFO", "VERDICT: ESCALATE"]
        }
      ]
    },
    {
      "id": "scp-region-restriction",
      "name": "Workload in new region blocked by SCP restricting aws:RequestedRegion",
      "difficulty": "medium",
      "prompt_file": "prompts/scp-region-restriction.md",
      "baseline_file": "baselines/scp-region-restriction.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "expected_root_cause_layer": "Organisation SCP (explicit deny)",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "SCP", "aws:RequestedRegion", "VERDICT", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: NEED_MORE_INFO"]
        }
      ]
    },
    {
      "id": "ec2-passrole-missing",
      "name": "EC2 Client.UnauthorizedOperation — missing iam:PassRole on instance profile",
      "difficulty": "medium",
      "prompt_file": "prompts/ec2-passrole-missing.md",
      "baseline_file": "baselines/ec2-passrole-missing.md",
      "expected_verdict": "ROOT_CAUSE_FOUND",
      "expected_root_cause_layer": "Identity-based policy — missing iam:PassRole",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["ROOT_CAUSE_FOUND", "iam:PassRole", "VERDICT", "PassRole", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "VERDICT: NEED_MORE_INFO", "Action: \"*\""]
        }
      ]
    },
    {
      "id": "insufficient-context-need-more-info",
      "name": "AccessDenied report without CloudTrail or simulator output — request more info",
      "difficulty": "easy",
      "prompt_file": "prompts/insufficient-context-need-more-info.md",
      "baseline_file": "baselines/insufficient-context-need-more-info.md",
      "expected_verdict": "NEED_MORE_INFO",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NEED_MORE_INFO", "VERDICT", "CloudTrail"]
        },
        {
          "type": "must_not_contain",
          "values": ["ROOT_CAUSE_FOUND", "ESCALATE", "Error:", "I cannot"]
        }
      ]
    }
  ]
}
