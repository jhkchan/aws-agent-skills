{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "cloudwatch-alarm-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the CloudWatch Alarm Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "no-action-static-threshold",
      "name": "Metric alarm with empty AlarmActions — fires into the void",
      "difficulty": "easy",
      "prompt_file": "prompts/no-action-static-threshold.md",
      "baseline_file": "baselines/no-action-static-threshold.md",
      "expected_verdict": "NO_ACTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ACTION", "VERDICT", "REASON", "REMEDIATION", "ALARM"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "missing-data-default-treatmissing",
      "name": "Custom error metric with default TreatMissingData and no InsufficientDataActions — silent blind spot",
      "difficulty": "hard",
      "prompt_file": "prompts/missing-data-default-treatmissing.md",
      "baseline_file": "baselines/missing-data-default-treatmissing.md",
      "expected_verdict": "INSUFFICIENT_DATA",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["INSUFFICIENT_DATA", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ACTION"]
        }
      ]
    },
    {
      "id": "static-threshold-variable-traffic",
      "name": "Static floor threshold on high-variance API traffic metric — should use AnomalyDetection",
      "difficulty": "medium",
      "prompt_file": "prompts/static-threshold-variable-traffic.md",
      "baseline_file": "baselines/static-threshold-variable-traffic.md",
      "expected_verdict": "NO_ANOMALY",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ANOMALY", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "composite-alarm-no-actions",
      "name": "Composite alarm with no AlarmActions — relies on child alarm actions",
      "difficulty": "medium",
      "prompt_file": "prompts/composite-alarm-no-actions.md",
      "baseline_file": "baselines/composite-alarm-no-actions.md",
      "expected_verdict": "NO_ACTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ACTION", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "well-configured-anomaly-ok",
      "name": "AnomalyDetection alarm with proper actions, TreatMissingData, and stdev 2 — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/well-configured-anomaly-ok.md",
      "baseline_file": "baselines/well-configured-anomaly-ok.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_ACTION", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "datapoints-exceeds-evaluation",
      "name": "DatapointsToAlarm exceeds EvaluationPeriods — impossible alarm condition",
      "difficulty": "hard",
      "prompt_file": "prompts/datapoints-exceeds-evaluation.md",
      "baseline_file": "baselines/datapoints-exceeds-evaluation.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ACTION"]
        }
      ]
    }
  ]
}
