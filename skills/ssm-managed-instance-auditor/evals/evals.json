{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "ssm-managed-instance-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the SSM Managed Instance Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "ec2-no-iam-profile-unmanaged",
      "name": "EC2 with no IAM instance profile — never registered with SSM",
      "difficulty": "medium",
      "prompt_file": "prompts/ec2-no-iam-profile-unmanaged.md",
      "baseline_file": "baselines/ec2-no-iam-profile-unmanaged.md",
      "expected_verdict": "UNMANAGED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNMANAGED", "ec2noiamprofileunmanaged", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NONCOMPLIANT", "VERDICT: NO_SESSION_MANAGER"]
        }
      ]
    },
    {
      "id": "hybrid-mi-connection-lost-unmanaged",
      "name": "Hybrid mi-* instance with stale ping (ConnectionLost, 9 days)",
      "difficulty": "hard",
      "prompt_file": "prompts/hybrid-mi-connection-lost-unmanaged.md",
      "baseline_file": "baselines/hybrid-mi-connection-lost-unmanaged.md",
      "expected_verdict": "UNMANAGED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["UNMANAGED", "hybridconnectionlostu", "VERDICT", "REASON", "REMEDIATION", "ConnectionLost"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NONCOMPLIANT"]
        }
      ]
    },
    {
      "id": "noncompliant-critical-patches-missing",
      "name": "Managed and green associations but 14 CRITICAL patches missing",
      "difficulty": "hard",
      "prompt_file": "prompts/noncompliant-critical-patches-missing.md",
      "baseline_file": "baselines/noncompliant-critical-patches-missing.md",
      "expected_verdict": "NONCOMPLIANT",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NONCOMPLIANT", "noncompliantcriticalpatches", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNMANAGED", "VERDICT: NO_SESSION_MANAGER"]
        }
      ]
    },
    {
      "id": "no-session-manager-ssh-open",
      "name": "Managed and compliant but SSH open to 0.0.0.0/0, no Session Manager",
      "difficulty": "medium",
      "prompt_file": "prompts/no-session-manager-ssh-open.md",
      "baseline_file": "baselines/no-session-manager-ssh-open.md",
      "expected_verdict": "NO_SESSION_MANAGER",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_SESSION_MANAGER", "nossessionmanagersshopen", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNMANAGED", "VERDICT: NONCOMPLIANT"]
        }
      ]
    },
    {
      "id": "config-gap-stale-agent-no-inventory",
      "name": "Compliant but stale agent and no inventory collection",
      "difficulty": "medium",
      "prompt_file": "prompts/config-gap-stale-agent-no-inventory.md",
      "baseline_file": "baselines/config-gap-stale-agent-no-inventory.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "configgapstaleagentnoinv", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: UNMANAGED", "VERDICT: NONCOMPLIANT", "VERDICT: NO_SESSION_MANAGER"]
        }
      ]
    },
    {
      "id": "ok-fully-managed-session-manager",
      "name": "Clean posture — managed, compliant, Session Manager active and logged",
      "difficulty": "easy",
      "prompt_file": "prompts/ok-fully-managed-session-manager.md",
      "baseline_file": "baselines/ok-fully-managed-session-manager.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "okfullymanagedsessma", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: UNMANAGED", "VERDICT: NONCOMPLIANT", "VERDICT: NO_SESSION_MANAGER", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
