{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "codepipeline-pipeline-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the CodePipeline Pipeline Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "no-encryption-artifact-store",
      "name": "Artifact store without encryptionKey — plaintext artifacts at rest",
      "difficulty": "easy",
      "prompt_file": "prompts/no-encryption-artifact-store.md",
      "baseline_file": "baselines/no-encryption-artifact-store.md",
      "expected_verdict": "NO_ENCRYPTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ENCRYPTION", "VERDICT", "REASON", "REMEDIATION", "UNENCRYPTED"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "overpermissive-cross-account-role",
      "name": "CloudFormation deploy action with cross-account RoleArn — privilege escalation blast radius",
      "difficulty": "medium",
      "prompt_file": "prompts/overpermissive-cross-account-role.md",
      "baseline_file": "baselines/overpermissive-cross-account-role.md",
      "expected_verdict": "OVERPERMISSIVE_ROLE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OVERPERMISSIVE_ROLE", "VERDICT", "REASON", "REMEDIATION", "222222222222"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "disabled-stage-transition",
      "name": "Deploy stage inbound transition disabled — operational freeze blocking all executions",
      "difficulty": "medium",
      "prompt_file": "prompts/disabled-stage-transition.md",
      "baseline_file": "baselines/disabled-stage-transition.md",
      "expected_verdict": "DISABLED_STAGE",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["DISABLED_STAGE", "VERDICT", "REASON", "REMEDIATION", "DISABLED"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "weak-source-no-approval",
      "name": "Deprecated GitHub v1 source with no manual approval gate — credential exposure and missing checkpoint",
      "difficulty": "hard",
      "prompt_file": "prompts/weak-source-no-approval.md",
      "baseline_file": "baselines/weak-source-no-approval.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "REMEDIATION", "DEPRECATED"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "well-configured-pipeline",
      "name": "CMK encryption, CodeStar Connection, manual approval with SNS, same-account roles — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/well-configured-pipeline.md",
      "baseline_file": "baselines/well-configured-pipeline.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["VERDICT: OK", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_ENCRYPTION", "VERDICT: OVERPERMISSIVE_ROLE", "VERDICT: DISABLED_STAGE", "VERDICT: CONFIG_GAP"]
        }
      ]
    },
    {
      "id": "multiple-findings-encryption-wins",
      "name": "Multiple findings (no encryption + GitHub v1 + disabled stage + cross-account role) — NO_ENCRYPTION dominates",
      "difficulty": "hard",
      "prompt_file": "prompts/multiple-findings-encryption-wins.md",
      "baseline_file": "baselines/multiple-findings-encryption-wins.md",
      "expected_verdict": "NO_ENCRYPTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ENCRYPTION", "VERDICT", "REASON", "REMEDIATION", "UNENCRYPTED"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
