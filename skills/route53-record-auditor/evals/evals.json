{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "route53-record-auditor",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Route 53 Record Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "failover-primary-no-healthcheck",
      "name": "Failover PRIMARY A record with no health check — failover is functionally disabled",
      "difficulty": "hard",
      "prompt_file": "prompts/failover-primary-no-healthcheck.md",
      "baseline_file": "baselines/failover-primary-no-healthcheck.md",
      "expected_verdict": "NO_HEALTH_CHECK",
      "expected_risk": "CRITICAL",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_HEALTH_CHECK", "failover-primary-no-healthcheck", "VERDICT", "REASON", "REMEDIATION", "CRITICAL"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DANGLING", "VERDICT: DNSSEC_GAP"]
        }
      ]
    },
    {
      "id": "dangling-alias-deleted-elb",
      "name": "ALIAS to deleted ELB — NXDOMAIN outage from dangling record",
      "difficulty": "medium",
      "prompt_file": "prompts/dangling-alias-deleted-elb.md",
      "baseline_file": "baselines/dangling-alias-deleted-elb.md",
      "expected_verdict": "DANGLING",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["DANGLING", "dangling-alias-deleted-elb", "VERDICT", "REASON", "REMEDIATION", "deleted"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_HEALTH_CHECK", "VERDICT: DNSSEC_GAP"]
        }
      ]
    },
    {
      "id": "dnssec-gap-public-zone",
      "name": "Public hosted zone without DNSSEC signing — cache-poisoning susceptibility",
      "difficulty": "easy",
      "prompt_file": "prompts/dnssec-gap-public-zone.md",
      "baseline_file": "baselines/dnssec-gap-public-zone.md",
      "expected_verdict": "DNSSEC_GAP",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["DNSSEC_GAP", "dnssec-gap-public-zone", "VERDICT", "REASON", "REMEDIATION", "HIGH"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DANGLING", "VERDICT: NO_HEALTH_CHECK"]
        }
      ]
    },
    {
      "id": "weighted-no-healthcheck",
      "name": "Weighted records with no health checks — traffic to dead endpoints",
      "difficulty": "medium",
      "prompt_file": "prompts/weighted-no-healthcheck.md",
      "baseline_file": "baselines/weighted-no-healthcheck.md",
      "expected_verdict": "NO_HEALTH_CHECK",
      "expected_risk": "HIGH",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_HEALTH_CHECK", "weighted-no-healthcheck", "VERDICT", "REASON", "REMEDIATION", "HIGH"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: DANGLING", "VERDICT: DNSSEC_GAP"]
        }
      ]
    },
    {
      "id": "ttl-inconsistency-weighted",
      "name": "Weighted records with health checks but inconsistent TTLs — broken distribution",
      "difficulty": "hard",
      "prompt_file": "prompts/ttl-inconsistency-weighted.md",
      "baseline_file": "baselines/ttl-inconsistency-weighted.md",
      "expected_verdict": "CONFIG_GAP",
      "expected_risk": "MEDIUM",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "ttl-inconsistency-weighted", "VERDICT", "REASON", "REMEDIATION", "MEDIUM"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_HEALTH_CHECK", "VERDICT: DANGLING", "VERDICT: DNSSEC_GAP"]
        }
      ]
    },
    {
      "id": "clean-weighted-ok",
      "name": "Properly configured weighted records with health checks, consistent TTLs, DNSSEC — clean posture",
      "difficulty": "easy",
      "prompt_file": "prompts/clean-weighted-ok.md",
      "baseline_file": "baselines/clean-weighted-ok.md",
      "expected_verdict": "OK",
      "expected_risk": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "clean-weighted-ok", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_HEALTH_CHECK", "VERDICT: DANGLING", "VERDICT: DNSSEC_GAP", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
