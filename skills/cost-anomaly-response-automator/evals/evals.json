{
  "$schema": "https://raw.githubusercontent.com/jhkchan/aws-agent-skills/main/schema/SKILL.schema.json",
  "skill": "cost-anomaly-response-automator",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Cost Anomaly Response Automator. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "cad-notify-slack-full-playbook",
      "name": "CAD-to-Slack full-playbook with notify, tag, approval gate, and budget action — all guardrails pass",
      "difficulty": "medium",
      "prompt_file": "prompts/cad-notify-slack-full-playbook.md",
      "baseline_file": "baselines/cad-notify-slack-full-playbook.md",
      "expected_verdict": "AUTOMATED",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["AUTOMATED", "cad-notify-slack-full-playbook", "GUARDRAILS", "AUDIT", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: MANUAL_STEP_REQUIRED"]
        }
      ]
    },
    {
      "id": "budgets-ec2-stop-missing-approval-gate",
