{
  "$schema": "https://github.com/jhkchan/aws-agent-skills/schema/SKILL.schema.json",
  "skill": "bedrock-model-access-inventory",
  "version": "1.0.0",
  "description": "Structured eval definitions for the Bedrock Model Access Inventory Auditor. Each eval case is a self-contained {id, name, difficulty, prompt, expected_output, files[], assertions[]} record. The prompt and baseline live in external files (see eval_config.yaml) so the same case can run with-skill vs without-skill (baseline) for delta comparison. The legacy eval/test-cases.yaml remains the CI assertion-layer surface discovered by eval/run_eval.py; this file is the canonical structured-eval eval surface.",
  "baseline_model": "amazon.nova-pro-v1:0",
  "eval_cases": [
    {
      "id": "no-invocation-logging",
      "name": "No invocation logging destinations — zero forensic audit trail",
      "difficulty": "medium",
      "prompt_file": "prompts/no-invocation-logging.md",
      "baseline_file": "baselines/no-invocation-logging.md",
      "expected_verdict": "NO_LOGGING",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_LOGGING", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "no-kms-customer-key",
      "name": "Logging active but no customer-managed KMS key — key-control gap",
      "difficulty": "medium",
      "prompt_file": "prompts/no-kms-customer-key.md",
      "baseline_file": "baselines/no-kms-customer-key.md",
      "expected_verdict": "NO_ENCRYPTION",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["NO_ENCRYPTION", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: NO_LOGGING"]
        }
      ]
    },
    {
      "id": "anthropic-claude-apac-geoblock",
      "name": "Anthropic Claude enabled in APAC — invocation geo-block risk",
      "difficulty": "hard",
      "prompt_file": "prompts/anthropic-claude-apac-geoblock.md",
      "baseline_file": "baselines/anthropic-claude-apac-geoblock.md",
      "expected_verdict": "GEO_BLOCK_RISK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["GEO_BLOCK_RISK", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: CONFIG_GAP", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "single-destination-logging",
      "name": "Single logging destination — redundancy gap",
      "difficulty": "medium",
      "prompt_file": "prompts/single-destination-logging.md",
      "baseline_file": "baselines/single-destination-logging.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_LOGGING", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "provisioned-throughput-expired",
      "name": "Provisioned throughput commitment expired — cost/config gap",
      "difficulty": "hard",
      "prompt_file": "prompts/provisioned-throughput-expired.md",
      "baseline_file": "baselines/provisioned-throughput-expired.md",
      "expected_verdict": "CONFIG_GAP",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["CONFIG_GAP", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: OK", "VERDICT: NO_LOGGING", "VERDICT: NO_ENCRYPTION"]
        }
      ]
    },
    {
      "id": "fully-configured-healthy",
      "name": "Fully configured — multi-destination logging, CMK, active PT, guardrails",
      "difficulty": "easy",
      "prompt_file": "prompts/fully-configured-healthy.md",
      "baseline_file": "baselines/fully-configured-healthy.md",
      "expected_verdict": "OK",
      "files": [],
      "assertions": [
        {
          "type": "must_contain",
          "values": ["OK", "VERDICT", "REASON", "REMEDIATION"]
        },
        {
          "type": "must_not_contain",
          "values": ["Error:", "I cannot", "I'm unable", "VERDICT: NO_LOGGING", "VERDICT: NO_ENCRYPTION", "VERDICT: GEO_BLOCK_RISK", "VERDICT: CONFIG_GAP"]
        }
      ]
    }
  ]
}
